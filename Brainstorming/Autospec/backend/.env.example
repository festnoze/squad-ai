# Autospec backend configuration template.
#
# Copy this file to `.env` and uncomment/adjust the values you need. Every line
# below shows a variable at its default value; leaving it commented keeps that
# default. Shell environment variables take precedence over the `.env` file.
#
# Sections:
#   1. LLM providers & models
#   2. Core execution & infrastructure
#   3. Planning pipeline (idea → plan)
#   4. Build pipeline (plan → code)
#   5. Quality gates & delivery
#   6. Observability & diagnostics
#   7. Cross-project learning
#   8. Dev scripts (not read by the server)


# ============================================================================
#  1. LLM PROVIDERS & MODELS
# ============================================================================

# -- Provider selector (M1) --
# Agent backend: "claude code" (Claude Code CLI harness, locally configured auth),
# "claude" (Anthropic API direct), "codex" (CLI harness), "openai", "ollama"
# or "openrouter" (via LangChain). Switchable at runtime through
# POST /api/provider.
# AGENT_PROVIDER=claude code
# Cap on the write/read tool-loop rounds of the LangChain providers.
# PROVIDER_TOOL_ROUNDS=8
# Product generation profile: auto / library-fast / cli / api / web-ssr /
# fullstack / brownfield.
# PRODUCT_PROFILE=auto

# -- Claude Code CLI (default provider) --
# Claude Code binary (default: auto-detected claude.cmd/.exe).
# CLAUDE_CMD=
# Claude Code model (default: sonnet). Use haiku for a smaller model.
# CLAUDE_MODEL=sonnet
# Agent permission mode.
# PERMISSION_MODE=bypassPermissions

# -- Codex CLI (OpenAI counterpart of the Claude Code CLI) --
# Codex binary (default: auto-detected codex.cmd/.exe).
# CODEX_CMD=
# Codex model (default: CLI's default model).
# CODEX_MODEL=

# -- OpenAI API (EMPTY key = provider unconfigured) --
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# USD per 1M input/output tokens, to estimate cost (0 = no estimate).
# OPENAI_PRICE_IN=0
# OPENAI_PRICE_OUT=0

# -- Anthropic API direct (M4) — the "claude" provider --
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_PRICE_IN=0
# ANTHROPIC_PRICE_OUT=0

# -- Ollama (local models) --
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# -- OpenRouter (OpenAI-compatible aggregator hub) --
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model id (EMPTY = pick from the live programming-models dropdown).
# OPENROUTER_MODEL=
# OPENROUTER_PRICE_IN=0
# OPENROUTER_PRICE_OUT=0

# -- Per-phase model routing (M3) --
# Override the model per BMAD phase; falls back to CLAUDE_MODEL.
# Phases: SPEC/ANALYZE/PLAN/ARCHITECT/BUILD/DONE.
# MODEL_SPEC=
# MODEL_ANALYZE=
# MODEL_PLAN=
# MODEL_ARCHITECT=
# MODEL_BUILD=
# MODEL_DONE=


# ============================================================================
#  2. CORE EXECUTION & INFRASTRUCTURE
# ============================================================================

# -- Paths --
# Directory of the BMAD install (default: Brainstorming/_bmad).
# BMAD_DIR=../_bmad
# Root directory for generated workspaces (default: Autospec/workspace).
# WORKSPACE_ROOT=./workspace
# At backend boot, kill every leftover process whose command line points INSIDE
# WORKSPACE_ROOT (leaked smoke run, uvicorn reload supervisor, repair-agent
# child) before recovering the projects; completes the port-scoped killer
# (#10/#13). Never touches anything outside the workspace root, nor this process
# and its ancestors. Skipped when FAKE_AGENTS=1. ON. 0 = legacy boot.
# ORPHAN_SWEEP_ON_BOOT=1

# -- Agent execution --
# Per-agent timeout in seconds.
# AGENT_TIMEOUT_S=1800
# Max number of Dev agents running in parallel.
# MAX_PARALLEL_DEVS=2
# Max attempts per Dev story.
# DEV_MAX_ATTEMPTS=2

# -- Toolchain binaries (per backend language / JS) --
# UV_CMD=uv
# GO_CMD=go
# CARGO_CMD=cargo
# NODE_CMD=node
# NPM_CMD=npm
# Share ONE npm download cache (<WORKSPACE_ROOT>/_npm-cache) across every
# per-worktree frontend install, with --prefer-offline (P2-B). The installs stay
# hermetic (node_modules per worktree); only the tarball cache is shared. ON.
# 0 = legacy (npm's default per-user cache, no --prefer-offline).
# NPM_SHARED_CACHE=1

# -- HTTP server --
# Idle keep-alive timeout (s) when launched via `python -m autospec.api.server`.
# KEEP_ALIVE_S=600

# -- Claude usage-window watchdog (M2, claude provider only) --
# Auto-schedule a resume when the Claude session usage window is exhausted.
# SESSION_MONITOR=1
# ccusage command used to read the active billing block's end time.
# CCUSAGE_CMD=npx --yes ccusage
# Fallback resume delay (minutes) when the reset time cannot be determined.
# RESUME_FALLBACK_MIN=60
# WF-P7: re-probe ccusage every N minutes while waiting and resume earlier if
# the billing block reopens sooner than the fallback estimate. 0 = disabled.
# RESUME_REPROBE_MIN=30

# -- Demo mode (scripted agents, no Claude CLI) --
# Enable scripted/fake agents (demo mode).
# FAKE_AGENTS=0
# Delay (s) for scripted agents in demo mode.
# DEMO_DELAY_S=0


# ============================================================================
#  3. PLANNING PIPELINE (idea → plan)
# ============================================================================

# -- Brainstorming assist for vague ideas (B-IDEA) --
# Vague goal -> BMAD brainstorming offer; declined/auto-spec -> autonomous run.
# BRAINSTORM_ASSIST=1
# Rounds of autonomous Q&A before the brief is synthesized.
# BRAINSTORM_ROUNDS=2

# -- PO pipeline (RFC po-pipeline-v2, multi-stage PO) --
# "off" (default) = legacy mono-pass PO; "on" = S1 + size-based S2/S3.
# PO_PIPELINE=off
# PO_PIPELINE_MIN_LEAVES=4
# PO_PIPELINE_GHERKIN=1

# -- Refinement & plan-review harness (maker -> critic -> judge) --
# Global on/off switch for the refinement harness.
# REFINE=0
# Refine the PO plan / Dev code (when global is ON).
# REFINE_PO=1
# REFINE_DEV=1
# Hard cap on maker<->critic round-trips.
# REFINE_MAX_ROUNDS=2
# Judge score threshold (0-100) to stop refining.
# REFINE_QUALITY_THRESHOLD=80
# Dedicated PO PLAN REVIEW (critic->judge->revise on epics/US/tasks) — reviews the
# breakdown + task complexity BEFORE the build, independent of REFINE.
# REVIEW_PLAN=0

# -- Architecture phase (optional, between PO and build) --
# Enable the Architect agent (design injected into QA/Dev prompts).
# ARCHITECTURE=0

# -- Backend-language selector (L2) --
# LANGUAGE_SELECTOR=0

# -- Components proposal & setup executor (E3/E4) --
# Enable the solution agent proposing product components after the brief.
# COMPONENTS=0
# Actually install component dependencies (uv sync / npm install).
# SETUP_INSTALL=0


# ============================================================================
#  4. BUILD PIPELINE (plan → code)
# ============================================================================

# -- Approval gate before build (U4) --
# Block after planning and wait for explicit human approval before building.
# APPROVAL_GATES=0

# -- Multi-stream build (ST-1: streams + tasks + parallel build) --
# Split work into streams (backend/frontend/cache/database) with an optional Task
# level under each US, so independent streams build in parallel. OFF = one
# implicit backend stream, no tasks (pre-streams behaviour unchanged).
# STREAMS=0

# -- Skills library (SK-1) --
# SKILLS=0
# SKILLS_QA=1
# SKILLS_DEV=1
# Bundled skill library (default: backend/autospec/skills).
# SKILLS_DIR=

# -- Decomposition & split-on-failure (SK-2, RFC technical-stories) --
# DECOMPOSE=0
# Adaptive split-on-failure (re-decompose a stuck item). ON by default.
# SPLIT_ON_FAILURE=1
# SPLIT_MAX_DEPTH=2
# Max files a LEAF task/story may touch to stay buildable in one session.
# TASK_FILE_BUDGET=3
# Wave 5: for a product expected to LISTEN on a port, add a deterministic
# web-wiring task (app factory + main.py starting uvicorn) at the end of the
# backend chain when no unit claims main.py. ON. 0 = historic behaviour.
# WEB_WIRING_TASK=1

# -- Parallel-build safety --
# LLM independence judge for the parallel build.
# INDEPENDENCE=0
# Post-merge canary: replay the suite on shared HEAD after each parallel merge. ON.
# POST_MERGE_CANARY=1
# Canary red with ZERO test executed and no known infra signature: repair and
# replay ONCE before believing the semantic verdict (P0-A). ON. 0 = legacy.
# CANARY_REPLAY_ON_EMPTY=1
# Canary by BURST instead of one full suite per merge (P1-A): under merge-lock
# contention the mergers park and the LAST one runs ONE canary for the whole
# burst; a red burst is bisected (revert newest first). ON. 0 = legacy.
# CANARY_BATCH=1
# Separate budget for the FUSION requeues (merge conflict, post-merge canary
# revert, red with zero test executed): DEV_MAX_ATTEMPTS only counts real code
# re-generations, so a collision with a sibling never burns a dev attempt (P0-B).
# REQUEUE_MAX=3
# Last resort before the adaptive split when the requeue budget is spent on a
# PERSISTENT merge conflict (P2-A): the item is rebuilt SOLO on the final HEAD
# (no other worker in flight, so no conflict is possible). Once per item, costs
# no budget, keeps the green branch. ON. 0 = legacy (split, then FAILED).
# SOLO_ON_CONFLICT=1
# Consolidate the STORED status of a task-decomposed story (D11): when all its
# tasks are DONE the story is marked DONE and ONE "story <id> done" commit is
# emitted; no other path commits that rollup early. ON. 0 = legacy.
# CONSOLIDATE_STORY_STATUS=1
# A red verification that executed ZERO test is infra, not code: repair the
# worktree env, replay ONCE, then refund the dev attempt onto INFRA_MAX_RETRIES
# (WORKFLOW_REVIEW P1). ON. 0 = legacy (the red costs a dev attempt).
# EMPTY_RED_IS_INFRA=1
# Schedule the ready items that transitively block the most work FIRST (critical
# path); declaration order stays the tie-break (P1-C). ON. 0 = legacy order.
# FANOUT_FIRST=1
# An item blocking at least this many others transitively gets ONE dev attempt
# more than DEV_MAX_ATTEMPTS before it FAILS, and ONE fusion requeue more than
# REQUEUE_MAX (P1-C). 0 disables both bonuses; REQUEUE_MAX=0 stays terminal.
# FANOUT_BONUS_THRESHOLD=5
# A worker waiting on the merge lock (MERGE_WAIT / MERGING / post-merge canary)
# no longer holds a dev slot, so a ready independent item can start while the
# merge queue drains (P1-B). Hard ceiling: MAX_PARALLEL_DEVS + 1 in flight.
# SLOT_RELEASE_ON_MERGE=1


# ============================================================================
#  5. QUALITY GATES & DELIVERY
# ============================================================================

# Deadline for each native backend/frontend test-suite execution.
# TEST_SUITE_TIMEOUT_S=180

# -- Smoke-run gate (boot the delivered app after the suite is green) --
# ON by default for generated apps.
# SMOKE_RUN=1
# SMOKE_RUN_TIMEOUT_S=60
# SMOKE_RUN_PORT=8000
# For a NON-web product (cli profile, or no web framework in its pyproject), also
# run `python main.py --help` and require exit 0 AND a non-empty stdout: "exit 0"
# alone is satisfied by a mute main.py (FACTORY_IMPROVEMENTS #4). ON.
# 0 = legacy (exit 0 only).
# SMOKE_CLI_HELP=1

# -- Definition of Done & partial delivery --
# Deterministic Definition-of-Done check. ON.
# DEFINITION_OF_DONE=1
# DOD_STRICT_CRITERIA=0
# A Technical Story extracted from a failed task inherits that task's acceptance
# criteria (or gets ONE synthetic criterion from its technical contract) plus a
# technical Gherkin, instead of being born with neither and raising a DoD
# warning on every delivery. ON. 0 = legacy TS (no criterion, no Gherkin).
# TS_ACCEPTANCE_CRITERIA=1
# Partial delivery: ship green stories, downgrade failed ones to warnings.
# PARTIAL_DELIVERY=0
# Separate retry budget for transient infra/provider failures.
# INFRA_MAX_RETRIES=3

# -- Runtime acceptance (exercise the running app against acceptance criteria) --
# RUNTIME_ACCEPTANCE=0
# RUNTIME_ACCEPTANCE_TIMEOUT_S=90

# -- Coverage gate (Q2) --
# COVERAGE=0
# COVERAGE_GATE=0

# -- Mutation testing (Q1) --
# MUTATION=0
# MUTATION_MAX=30

# -- Playwright UI acceptance tests (E5) --
# Adds pytest-playwright to new workspaces; requires browsers installed.
# UI_TESTS=1

# -- Security & supply-chain review (S1) --
# SECURITY_REVIEW=0
# SECURITY_AUDIT_TIMEOUT_S=60

# -- Closed-loop product evaluator (E6) --
# EVALUATOR=0
# EVALUATOR_RUN_TIMEOUT_S=20

# -- Untrusted-code sandbox (R1, Docker) --
# SANDBOX=0
# SANDBOX_IMAGE=python:3.12-slim
# DOCKER_CMD=docker

# -- Deterministic technical foundation (before PO/story generation) --
# Create the selected stack, install dependencies, test it, and check real HTTP
# and fullstack communication before developing features. Fake-agent demos skip
# external installations. Unsupported stacks fail with an explicit diagnostic.
# PROJECT_BOOTSTRAP=1
# Overall bootstrap deadline in seconds.
# BOOTSTRAP_TIMEOUT_S=180

# -- Docker delivery (web services, CLI and library images) --
# Python/Go/Rust/Node backends and React frontends use stack-specific templates.
# Web services verify HTTP and cross-container reachability on a shared network;
# CLI/library images are packaged without publishing a permanent HTTP service.
# ON by default for all new projects, including CLI and library profiles.
# Imported brownfield projects remain opt-in. Requires a running Docker engine.
# An explicit DOCKER_DELIVERY=0 overrides every profile.
# Reuses DOCKER_CMD and INTEGRATION_FIX_ATTEMPTS. Manual deploy bypasses the flag.
# DOCKER_DELIVERY=1
# Shared Docker network joined by every deployed Autospec container.
# DOCKER_NETWORK=autospec-net
# Timeout (s) for the docker build step.
# DOCKER_BUILD_TIMEOUT_S=600
# Health-wait window (s) after the container starts.
# DOCKER_DEPLOY_TIMEOUT_S=60
# Base of the stable host-port range assigned to deployed containers.
# DOCKER_HOST_PORT_BASE=18000

# -- Delivery (I2): tech-writer README after each build --
# Always available on demand via POST /document.
# TECH_WRITER=0


# ============================================================================
#  6. OBSERVABILITY & DIAGNOSTICS
# ============================================================================

# -- Langfuse tracing (O1) --
# LANGFUSE=0


# ============================================================================
#  7. CROSS-PROJECT LEARNING
# ============================================================================

# -- Cross-project lesson library (F1) --
# SHARED_LESSONS=0
# SHARED_LESSONS_MAX=20

# -- Factory retrospective (E7) --
# RETRO=0
# RETRO_MAX_LESSONS=12


# ============================================================================
#  8. DEV SCRIPTS (not read by the server)
# ============================================================================

# build_driver.py wall-clock cap (s).
# DRIVER_CAP_S=2400
# eval_po_pipeline.py provider.
# EVAL_PROVIDER=scripted


# ============================================================================
#  9. VERIFIED SWARM UPGRADE (waves 0–5 — all OFF by default)
# ============================================================================
# Fold the multi-agent "verified swarm" recipe into the factory. Every flag is
# additive and OFF by default; with all off the pipeline is byte-identical to
# before. See VERIFIED_SWARM_UPGRADE.md for the design and todo_tasks.md for the
# per-wave status.

# -- W0: quality preset + telemetry --
# PRESET=verified turns ON the whole existing verification gauntlet (refine,
# plan review, coverage, mutation, evaluator, security review, runtime
# acceptance, strict DoD). Overrides .env defaults but yields to a shell override.
# PRESET=
# Flag (never truncate) a prompt whose char count nears this budget. 0 = off.
# CONTEXT_WARN_CHARS=0

# -- W0.5: anti-cheating guards & harness hardening (modes: off|warn|strict) --
# Revert/flag a dev turn that edits QA-authored tests.
# TEST_TAMPER_GUARD=off
# Flag/revert dev edits outside the item's declared file claims.
# SCOPE_GUARD=off
# Flag pass-only / hardcoded-return / skipped implementations.
# SKELETON_GUARD=off
# Flag imports that resolve to neither the manifest nor stdlib nor the project.
# IMPORT_GUARD=off
# Rerun a red suite once; a pass-on-rerun is a flake, not a real failure.
# FLAKY_RERUN=0

# -- W1: recovery ladder --
# On a retry, climb MODEL_LADDER (cost-ascending) to a stronger model.
# ESCALATE_ON_RETRY=0
# MODEL_LADDER=claude-haiku-4-5-20251001,claude-sonnet-4-6,claude-opus-4-8
# On attempt exhaustion, ask a boss-tier classifier for the root cause.
# CLASSIFY_ON_EXHAUSTION=0

# -- W2: AC traceability + wrong-test arbitration --
# Report acceptance criteria with no test + orphan tests at the delivery gate.
# AC_TRACEABILITY=0
# Let a boss-tier arbiter correct a WRONG test (grounded in the criteria) when a
# story exhausts its attempts; bounded per story per iteration.
# DISPUTE_ESCALATION=0
# ARBITRATION_MAX=1

# -- W3: project constitution --
# Derive project-wide rules after SPEC and compile them to executed checks
# (pytest files under tests/constitution/) or advisory guidance.
# CONSTITUTION=0
# CONSTITUTION_MAX=8

# -- W4: role-tier routing + cost ledger --
# Route each agent by cost tier (boss plans/reviews/arbitrates, workers code,
# checkers verify). Boss never codes. Off → per-phase router unchanged.
# ROLE_ROUTING=0
# MODEL_BOSS=claude-opus-4-8
# MODEL_WORKER=claude-haiku-4-5-20251001
# MODEL_CHECKER=claude-sonnet-4-6
# USD per 1M tokens per tier, to estimate cost when the runner returns none
# (Codex/OpenAI/Ollama) and to compute the frontier-only counterfactual.
# PRICE_BOSS_IN=0
# PRICE_BOSS_OUT=0
# PRICE_WORKER_IN=0
# PRICE_WORKER_OUT=0
# PRICE_CHECKER_IN=0
# PRICE_CHECKER_OUT=0

# -- W5: human-gated design amendment --
# On a genuine spec contradiction, propose a minimal amendment, run an
# INDEPENDENT weakening check, and queue the survivor HUMAN-PENDING.
# DESIGN_AMENDMENT=0
# AMENDMENT_AUTO=0
# AMENDMENT_MAX_DEPTH=1

# -- R6 (UX wave 3): story trash & restore --
# Deleting a story moves it to a bounded trash (20 entries) with the depends_on
# links stripped from its siblings, so POST /api/projects/<pid>/stories/<sid>/restore
# can put it back on the board. ON. 0 = historic hard delete (no trash).
# SOFT_DELETE_STORIES=1
