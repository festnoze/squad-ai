  "structure": {
   "multi-outcome-leg": {
    "patterns": [
     "\\band\\b[^?]*\\bbe\\s+(?:above|below)\\b",
     "\\([a-z][a-z ]*:\\s*[^,)]+,\\s*[a-z][a-z ]*:\\s*[^)]+\\)",
     "^what will be the\\b"
    ]
   },
   "recurring-series-leg": {
    "patterns": [
     "\\b(?:hottest|coldest|wettest|driest|warmest)\\b[^?]*\\bever\\b"
    ]
   },
   "range-band": {
    "patterns": [
     "\\bbetween\\s+\\$?[\\d,.]+\\s+and\\s+\\$?[\\d,.]+",
     "\\(\\s*\\$?[\\d,.]+\\s*(?:to|and)\\s*\\$?[\\d,.]+\\s*\\)",
     "\\b\\d[\\d,.]*\\s+to\\s+\\d[\\d,.]*\\s+\\w+\\b"
    ]
   },
   "count-over-period": {
    "patterns": [
     "\\b(?:more than|at least|fewer than|above)\\s+\\d[\\d,.]*\\s+\\w+[^?]*\\b(?:between|in|during|by|the week of)\\b",
     "\\b(?:how many|number of)\\b",
     "\\bfor\\s+\\d+\\s+or more consecutive\\b",
     "\\bmake\\s+\\d+\\s+trips\\b",
     "\\bsign\\s+more than\\s+\\d+\\b",
     "\\b(?:more than|at least|fewer than)\\s+\\d[\\d,.]*\\s+[a-z]+s\\b"
    ]
   },
   "head-to-head": {
    "patterns": [
     "\\b(?:more|higher|larger|greater|sooner|earlier|better)\\b[^?]*\\bthan\\s+(?!\\$?[\\d.,]+\\b)",
     "\\bbefore\\b[^?]*\\bflight\\s+\\d+\\b",
     "\\bwins?\\b"
    ]
   },
   "threshold-above": {
    "patterns": [
     "\\b(?:above|higher than|greater than|more than|over|at or above|exceeds?|rise more than)\\b",
     "\\bbe\\s+at least\\s+\\$?[\\d,.]+",
     "\\b(?:snow|rain)\\s+in\\b"
    ]
   },
   "threshold-below": {
    "patterns": [
     "\\b(?:below|lower than|less than|under|at or below)\\b"
    ]
   },
   "by-date": {
    "patterns": [
     "\\b(?:by|before|on or before|prior to)\\s+(?:\\d{1,2}:\\d{2}|the\\s+)?(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec|end of|new year)",
     "\\b(?:by|before)\\s+(?:pi day|next month|year end)",
     "\\b(?:happen|occur|be released|be announced|resign|leave|sign|agree|attend|arrested|released|reenabled|remove|withdraw|form|announce|invited|declare|partners|issue)\\b[^?]*\\b(?:before|by|provided)\\b",
     "\\b(?:in|during)\\s+\\d{4}\\?"
    ]
   },
   "other": {
    "patterns": []
   }
  },
  "horizon": [
   "intraday",
   "week",
   "month",
   "quarter",
   "year-plus"
  ],
  "builder": [
   "forecastable_from_public_models"
  ]
