{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmx.local/schemas/sensor.v1.json",
  "title": "pmx sensor catalogue v1",
  "description": "The declaration document of the closed sensor catalogue of CONTRACTS_V2 18.1 (amendment C1c): fifteen named, versioned, costed views of as-of information, each gating the MarketView and Observation fields it names and producing a fixed-width integer SensorBlock whose layout is its features tuple. catalogue_hash is sha256(canonical_json(sensors)) over the sensors list sorted by name and is what run_started.sensor_catalogue_hash records. The normative catalogue is tests/fixtures/contract/sensor.catalogue.json, which package S1 implements exactly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_hash",
    "sensors"
  ],
  "properties": {
    "schema_version": {
      "const": "sensor.v1"
    },
    "catalogue_hash": {
      "$ref": "#/$defs/sha256"
    },
    "sensors": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/sensorSpec"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sensorName": {
      "enum": [
        "calendar",
        "comments",
        "cross_asset",
        "filings",
        "gdelt_recent",
        "hive_insights",
        "hive_reputation",
        "hn",
        "macro_releases",
        "memory",
        "microstructure",
        "tape",
        "volume_profile",
        "wiki_asof",
        "wiki_daily"
      ]
    },
    "newsSource": {
      "enum": [
        "wikipedia_current_events",
        "wikipedia_asof",
        "wayback",
        "gdelt",
        "manifold_comment",
        "edgar",
        "fred",
        "cboe",
        "hn"
      ]
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,63}$"
    },
    "featureSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "unit",
        "lo",
        "hi",
        "scale",
        "source",
        "asof_only",
        "description",
        "features_v1_index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "unit": {
          "enum": [
            "bp",
            "milli",
            "ppm",
            "permille",
            "count",
            "index",
            "flag",
            "cents"
          ]
        },
        "lo": {
          "type": "integer"
        },
        "hi": {
          "type": "integer"
        },
        "scale": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/sensorName"
        },
        "asof_only": {
          "const": true
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "features_v1_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "sensorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "cost_units",
        "granularity_ms",
        "lag_ms",
        "sources",
        "market_fields",
        "observation_fields",
        "per_market",
        "features"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/sensorName"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z_]+\\.v[0-9]+$"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "granularity_ms": {
          "type": "integer",
          "minimum": 0
        },
        "lag_ms": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/newsSource"
          }
        },
        "market_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "observation_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "per_market": {
          "type": "boolean",
          "description": "true when the block is computed per open market (SensorBlock.market_id set), false for an observation-level block."
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/featureSpec"
          }
        }
      }
    }
  }
}
