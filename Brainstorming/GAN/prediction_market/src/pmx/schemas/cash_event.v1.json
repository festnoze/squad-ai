{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmx.local/schemas/cash_event.v1.json",
  "title": "pmx cash event v1",
  "description": "One dated cash flow that is not a fill (CONTRACTS_V2 17.3, ruling R151): a perp funding payment, an equity dividend or split, a future's roll, a borrow fee on a short, or the engine's forced flat at the window end. The first four come from data and sit inside an instrument file; the last two are generated by the engine. Execution applies every event in the settle phase of bar_of(t_ms) and journals it once as cash_event_applied. cash_event_id is ce- plus the first sixteen hex digits of sha256(canonical_json([market_id, kind, t_ms, detail])).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cash_event_id", "market_id", "kind", "t_ms", "origin", "source_url", "detail"],
  "properties": {
    "schema_version": { "const": "cash_event.v1" },
    "cash_event_id": { "type": "string", "pattern": "^ce-[0-9a-f]{16}$" },
    "market_id": {
      "type": "string",
      "pattern": "^(kalshi|manifold|polymarket|metaculus|demo|binance|kraken|coinbase|bybit|xnys|xnas|arcx|xcme|xnym|xcec|xcbt|otcfx)-[A-Za-z0-9._-]{1,96}$"
    },
    "kind": { "enum": ["funding", "dividend", "split", "roll", "borrow_fee", "forced_flat"] },
    "t_ms": { "$ref": "#/$defs/ms" },
    "origin": { "enum": ["data", "engine"] },
    "source_url": { "type": "string", "maxLength": 512 },
    "detail": {
      "description": "The kind's fields, integers and strings only (canonical-json-able). The allOf below pins the required keys per kind.",
      "type": "object",
      "additionalProperties": { "type": ["integer", "string"] }
    }
  },
  "allOf": [
    {
      "description": "A funding, dividend, split or roll is data and names where it was read.",
      "if": { "properties": { "kind": { "enum": ["funding", "dividend", "split", "roll"] } }, "required": ["kind"] },
      "then": { "properties": { "origin": { "const": "data" }, "source_url": { "minLength": 1 } } },
      "else": { "properties": { "origin": { "const": "engine" }, "source_url": { "const": "" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "funding" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "detail": {
            "required": ["rate_ppm", "mark_ticks"],
            "properties": { "rate_ppm": { "type": "integer" }, "mark_ticks": { "$ref": "#/$defs/priceTicks" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "dividend" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "detail": {
            "required": ["dividend_micro"],
            "properties": { "dividend_micro": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "split" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "detail": {
            "required": ["numerator", "denominator"],
            "properties": {
              "numerator": { "type": "integer", "minimum": 1 },
              "denominator": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "roll" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "detail": {
            "required": ["from_symbol", "to_symbol", "from_price_ticks", "to_price_ticks", "gap_ticks"],
            "properties": {
              "from_symbol": { "type": "string", "minLength": 1 },
              "to_symbol": { "type": "string", "minLength": 1 },
              "from_price_ticks": { "$ref": "#/$defs/priceTicks" },
              "to_price_ticks": { "$ref": "#/$defs/priceTicks" },
              "gap_ticks": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "borrow_fee" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "detail": {
            "required": ["rate_ppm_per_day", "days", "mark_ticks"],
            "properties": {
              "rate_ppm_per_day": { "$ref": "#/$defs/nonNegInt" },
              "days": { "type": "integer", "minimum": 1 },
              "mark_ticks": { "$ref": "#/$defs/priceTicks" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "forced_flat" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "detail": {
            "required": ["reason", "price_ticks"],
            "properties": {
              "reason": { "enum": ["window_end", "delisted"] },
              "price_ticks": { "$ref": "#/$defs/priceTicks" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ms": { "type": "integer", "minimum": 0 },
    "nonNegInt": { "type": "integer", "minimum": 0 },
    "priceTicks": { "type": "integer", "minimum": 1, "maximum": 1000000000000 }
  }
}
