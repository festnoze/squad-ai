{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmx.local/schemas/dataset.v1.json",
  "title": "pmx dataset manifest v1",
  "description": "The manifest of a dataset directory: window, filters and what they removed, counts, news sources, the chronological split, the file digests and the dataset hash. Sealed datasets carry sealed: true and are immutable. CONTRACTS_V2 sections 7.7 and 7.8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "name", "freeze_date", "freeze_ms", "window", "interval_min", "providers", "safety_lag_ms",
    "filters", "counts", "news", "split", "files", "dataset_hash", "built_by", "sealed", "notes"
  ],
  "properties": {
    "schema_version": { "const": "dataset.v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "freeze_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "freeze_ms": { "$ref": "#/$defs/ms" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": { "start_ms": { "$ref": "#/$defs/ms" }, "end_ms": { "$ref": "#/$defs/ms" } }
    },
    "interval_min": { "enum": [1, 60, 1440] },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["kalshi", "manifold", "polymarket", "metaculus", "demo", "binance", "kraken", "coinbase", "bybit", "xnys", "xnas", "arcx", "xcme", "xnym", "xcec", "xcbt", "otcfx"] }
    },
    "safety_lag_ms": { "$ref": "#/$defs/ms" },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "removed"],
      "properties": {
        "config": {
          "description": "BuildConfig.to_dict() of CONTRACTS_V2 section 7.4, verbatim.",
          "type": "object",
          "additionalProperties": { "type": ["integer", "boolean", "string", "array"] }
        },
        "removed": {
          "description": "Exactly the ten filter keys of CONTRACTS_V2 section 7.4, every one always present and 0 when the filter removed nothing, so the dataset panel and the gate's shortfall report read a fixed shape.",
          "type": "object",
          "additionalProperties": false,
          "required": ["window", "opened_early", "binary", "min_trades", "min_life", "density", "self_resolved", "kalshi_shards", "resolution", "no_leak"],
          "properties": {
            "window": { "$ref": "#/$defs/nonNegInt" },
            "opened_early": { "$ref": "#/$defs/nonNegInt" },
            "binary": { "$ref": "#/$defs/nonNegInt" },
            "min_trades": { "$ref": "#/$defs/nonNegInt" },
            "min_life": { "$ref": "#/$defs/nonNegInt" },
            "density": { "$ref": "#/$defs/nonNegInt" },
            "self_resolved": { "$ref": "#/$defs/nonNegInt" },
            "kalshi_shards": { "$ref": "#/$defs/nonNegInt" },
            "resolution": { "$ref": "#/$defs/nonNegInt" },
            "no_leak": { "$ref": "#/$defs/nonNegInt" }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markets", "per_provider", "per_category", "resolution_yes", "resolution_no", "hardness_tags"],
      "properties": {
        "markets": { "$ref": "#/$defs/nonNegInt" },
        "per_provider": { "$ref": "#/$defs/countMap" },
        "per_category": { "$ref": "#/$defs/countMap" },
        "resolution_yes": { "$ref": "#/$defs/nonNegInt" },
        "resolution_no": { "$ref": "#/$defs/nonNegInt" },
        "hardness_tags": { "$ref": "#/$defs/countMap" },
        "illiquid_boundary_milli": {
          "description": "The bottom-decile boundary of median daily volume per provider slice, in milli-contracts (CONTRACTS_V2 7.5, ruling R98). A provider whose slice was too small for a tenth percentile is absent.",
          "$ref": "#/$defs/countMap"
        },
        "n_bars_only": {
          "description": "Kept markets whose tape is bars_only (market.v2 quality.tape_kind): the only path through the min_trades filter of CONTRACTS_V2 7.4 that a provider with no settled print tape has. Zero means every market of this dataset came in on prints.",
          "$ref": "#/$defs/nonNegInt"
        },
        "n_category_fallback": {
          "description": "Kept markets whose category is the other fallback because nothing named a better one: a provider whose listing rows carry no category and whose series is absent from the series-to-category map. Reported because a flat other slice is a measurement failure, not a fact about the markets.",
          "$ref": "#/$defs/nonNegInt"
        },
        "precap_per_provider_month": {
          "description": "Per provider, the twelve month buckets of the window (CONTRACTS_V2 7.7) counted after every filter of 7.4 and before limit_per_provider was applied. The dataset shows what was sampled; this shows what there was to sample from, which is what makes the cap auditable.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "items": { "$ref": "#/$defs/nonNegInt" }
          }
        }
      }
    },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "n_items", "n_linked"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "n_items", "fetched_at_ms_min", "fetched_at_ms_max"],
            "properties": {
              "source": { "enum": ["wikipedia_current_events", "wikipedia_asof", "wayback", "gdelt", "manifold_comment", "edgar", "fred", "cboe", "hn"] },
              "n_items": { "$ref": "#/$defs/nonNegInt" },
              "fetched_at_ms_min": { "$ref": "#/$defs/ms" },
              "fetched_at_ms_max": { "$ref": "#/$defs/ms" }
            }
          }
        },
        "n_items": { "$ref": "#/$defs/nonNegInt" },
        "n_linked": { "$ref": "#/$defs/nonNegInt" },
        "safety_lag_by_source": { "description": "Amendment C1c (CONTRACTS_V2 5.5, 18.3, ruling R241): the lag applied per source; optional, a manifest without it lags every source by safety_lag_ms.", "type": "object", "additionalProperties": { "$ref": "#/$defs/ms" } },
        "linker_audit": { "description": "Decision D-R4, ruling R250: the fifty-link precision audit; null until gate G3 reviews it.", "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/audit" } ] }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month_edges_ms", "train_end_ms", "validation_end_ms", "n_train", "n_validation", "n_sealed"],
      "properties": {
        "month_edges_ms": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/ms" } },
        "train_end_ms": { "$ref": "#/$defs/ms" },
        "validation_end_ms": { "$ref": "#/$defs/ms" },
        "n_train": { "$ref": "#/$defs/nonNegInt" },
        "n_validation": { "$ref": "#/$defs/nonNegInt" },
        "n_sealed": { "$ref": "#/$defs/nonNegInt" },
        "n_instruments_train": { "description": "Amendment C1b (17.6, 17.9): a continuous instrument belongs to every fold whose months it has bars in, so the three count instruments per fold and do not partition them. Absent from a binary-only manifest.", "$ref": "#/$defs/nonNegInt" },
        "n_instruments_validation": { "$ref": "#/$defs/nonNegInt" },
        "n_instruments_sealed": { "$ref": "#/$defs/nonNegInt" },
        "method": { "description": "Amendment C1c (CONTRACTS_V2 7.7, decisions D-R1 and D-R2, rulings R247 and R248): the six fields are optional, absent from a manifest cut by calendar thirds before the amendment, and written by every build from DS1 on.", "const": "count_quantile" },
        "quantiles_permille": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1, "maximum": 999 } },
        "train_end_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "validation_end_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "cluster_moves": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["market_id", "from_fold", "to_fold", "group_id"], "properties": { "market_id": { "type": "string", "maxLength": 128 }, "from_fold": { "enum": ["train", "validation", "sealed"] }, "to_fold": { "enum": ["train", "validation", "sealed"] }, "group_id": { "type": "string", "maxLength": 128 } } } },
        "n_moved": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(markets|news|wiki_asof|clusters|instruments|calendars|taxonomy)/[A-Za-z0-9._/-]+$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "$ref": "#/$defs/nonNegInt" }
        }
      }
    },
    "dataset_hash": { "$ref": "#/$defs/sha256" },
    "built_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pmx_version", "contract_version", "rng_algorithm_version"],
      "properties": {
        "pmx_version": { "type": "string" },
        "contract_version": { "type": "string" },
        "rng_algorithm_version": { "type": "string" }
      }
    },
    "sealed": { "type": "boolean" },
    "notes": { "type": "string", "maxLength": 4000 },
    "kinds": {
      "description": "Amendment C1b (CONTRACTS_V2 7.8, 17.9, ruling R149; applied by gate G2): the instrument kinds the dataset carries. Absent from a manifest written before the amendment, which is a binary-only dataset.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["binary", "spot_crypto", "perp", "fx", "equity", "future"] }
    },
    "instruments": {
      "description": "Amendment C1b (7.8, 17.9): the counts of the continuous instruments under instruments/ and of the calendars under calendars/. Absent from a binary-only dataset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["per_kind", "per_provider", "per_vendor", "n_cash_events", "n_calendars"],
      "properties": {
        "per_kind": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegInt" } },
        "per_provider": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegInt" } },
        "per_vendor": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegInt" } },
        "n_cash_events": { "type": "object", "additionalProperties": false, "required": ["per_kind"], "properties": { "per_kind": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegInt" } } } },
        "n_calendars": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "schedules": {
      "description": "Amendment C1b (7.8, 17.4, 17.9): the fee, borrow and carry schedule ids the dataset's instruments name. Absent from a binary-only dataset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fee", "borrow", "carry"],
      "properties": {
        "fee": { "$ref": "#/$defs/scheduleIdList" },
        "borrow": { "$ref": "#/$defs/scheduleIdList" },
        "carry": { "$ref": "#/$defs/scheduleIdList" }
      }
    },
    "clusters": {
      "description": "CONTRACTS_V2 16.3 (ruling R117): the summary of clusters/clusters.json, absent from a dataset built with no cluster matcher. clusters.json carries no dataset_hash of its own, because its bytes are inside that hash (ruling R128); overrides_sha256 is what pins the hand-written review.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcher_version", "min_score_permille", "resolution_tolerance_ms", "overrides_sha256",
        "n_clusters", "n_clusters_asof", "n_cross_venue", "n_constraints", "per_kind",
        "n_markets_clustered"
      ],
      "properties": {
        "matcher_version": { "type": "string", "pattern": "^clusters\\.v[0-9]+$" },
        "min_score_permille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "resolution_tolerance_ms": { "$ref": "#/$defs/ms" },
        "overrides_sha256": { "$ref": "#/$defs/sha256" },
        "n_clusters": { "$ref": "#/$defs/nonNegInt" },
        "n_clusters_asof": { "$ref": "#/$defs/nonNegInt" },
        "n_cross_venue": { "$ref": "#/$defs/nonNegInt" },
        "n_constraints": { "$ref": "#/$defs/nonNegInt" },
        "per_kind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sum_to_one", "implies", "monotone_ladder", "complement"],
          "properties": {
            "sum_to_one": { "$ref": "#/$defs/nonNegInt" },
            "implies": { "$ref": "#/$defs/nonNegInt" },
            "monotone_ladder": { "$ref": "#/$defs/nonNegInt" },
            "complement": { "$ref": "#/$defs/nonNegInt" }
          }
        },
        "n_markets_clustered": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "impact": {
      "description": "CONTRACTS_V2 16.1 (ruling R135): the impact coefficients the calibrated_impact liquidity model reads, one per liquidity decile, regressed by pmx.data.impact on the TRAINING fold only. fit_fold is train and fit_t1_ms is the last resolution the regression saw, so pmx claim can refuse a calibrated run whose calibration ran past the claim's t0_ms. liquidity_decile is ranked over the same fold.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fit_fold", "fit_t1_ms", "params_sha256", "impact_bp_per_pct_by_decile", "n_markets_fit"],
      "properties": {
        "fit_fold": { "const": "train" },
        "fit_t1_ms": { "$ref": "#/$defs/ms" },
        "params_sha256": { "$ref": "#/$defs/sha256" },
        "impact_bp_per_pct_by_decile": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/nonNegInt" }
        },
        "n_markets_fit": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "purpose": { "description": "Amendment C1c (CONTRACTS_V2 5.6, 7.8, decision D-S4, ruling R263): research or showcase. Every block from here to build is optional, because a manifest written before the amendment has none, and is written by every build from DS1 on.", "enum": ["research", "showcase"] },
    "window_days": { "type": "integer", "minimum": 1, "maximum": 730 },
    "resolution_span": { "type": "object", "additionalProperties": false, "required": ["min_ms", "max_ms"], "properties": { "min_ms": { "$ref": "#/$defs/ms" }, "max_ms": { "$ref": "#/$defs/ms" } } },
    "universe": {
      "description": "Decision D-R13, ruling R258: the Kalshi series list is an output of the builder.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "series", "n_series_before", "n_series_after"],
      "properties": {
        "rule": { "type": "object", "additionalProperties": false, "required": ["min_settled", "min_volume_cents"], "properties": { "min_settled": { "$ref": "#/$defs/nonNegInt" }, "min_volume_cents": { "$ref": "#/$defs/nonNegInt" } } },
        "series": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["series", "n_settled", "n_kept", "volume_cents", "labels"], "properties": { "series": { "type": "string", "pattern": "^[A-Z0-9]{1,32}$" }, "n_settled": { "$ref": "#/$defs/nonNegInt" }, "n_kept": { "$ref": "#/$defs/nonNegInt" }, "volume_cents": { "$ref": "#/$defs/nonNegInt" }, "labels": { "type": "array", "uniqueItems": true, "items": { "enum": ["forecastable_from_public_models"] } } } } },
        "n_series_before": { "$ref": "#/$defs/nonNegInt" },
        "n_series_after": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "taxonomy": {
      "description": "Decisions D-S6, D-S8, D-S9 as corrected by D-S14, rulings R265, R267 and R268: coverage per venue and per facet, the cohort histogram and the fifty-tagging audit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "lexicon_sha256", "series_facets_sha256", "per_venue", "cohort_size_histogram", "audit"],
      "properties": {
        "version": { "const": "tags.v1" },
        "lexicon_sha256": { "$ref": "#/$defs/sha256" },
        "series_facets_sha256": { "$ref": "#/$defs/sha256" },
        "per_venue": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_coverage_permille", "structure_coverage_permille", "n_distinct_subjects", "n_other_subject", "n_other_structure", "n_platform_meta", "n_cohorts", "n_cohorts_usable", "label"],
            "properties": {
              "subject_coverage_permille": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "structure_coverage_permille": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "n_distinct_subjects": { "$ref": "#/$defs/nonNegInt" },
              "n_other_subject": { "$ref": "#/$defs/nonNegInt" },
              "n_other_structure": { "$ref": "#/$defs/nonNegInt" },
              "n_platform_meta": { "$ref": "#/$defs/nonNegInt" },
              "n_cohorts": { "$ref": "#/$defs/nonNegInt" },
              "n_cohorts_usable": { "$ref": "#/$defs/nonNegInt" },
              "label": { "enum": ["ok", "weak"] }
            }
          }
        },
        "cohort_size_histogram": { "type": "object", "additionalProperties": false, "required": ["1", "2-4", "5-9", "10-29", "30+"], "properties": { "1": { "$ref": "#/$defs/nonNegInt" }, "2-4": { "$ref": "#/$defs/nonNegInt" }, "5-9": { "$ref": "#/$defs/nonNegInt" }, "10-29": { "$ref": "#/$defs/nonNegInt" }, "30+": { "$ref": "#/$defs/nonNegInt" } } },
        "audit": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/audit" } ] }
      }
    },
    "cohorts": {
      "description": "Decision D-S7, ruling R266: every field of 18.5's Cohort but market_ids, sorted by cohort_id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cohort_id", "category", "subject", "structure", "horizon", "provider", "n_train", "n_validation", "n_sealed", "usable", "usable_for_paired_test"],
        "properties": {
          "cohort_id": { "type": "string", "pattern": "^co-[a-z]+-[a-z]+-[a-z0-9-]+-[a-z-]+-[a-z-]+$", "maxLength": 96 },
          "category": { "type": "string", "pattern": "^[a-z]+$" },
          "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "structure": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "horizon": { "enum": ["intraday", "week", "month", "quarter", "year-plus"] },
          "provider": { "type": "string", "pattern": "^[a-z]+$" },
          "n_train": { "$ref": "#/$defs/nonNegInt" },
          "n_validation": { "$ref": "#/$defs/nonNegInt" },
          "n_sealed": { "$ref": "#/$defs/nonNegInt" },
          "usable": { "type": "boolean" },
          "usable_for_paired_test": { "type": "boolean" }
        }
      }
    },
    "build": {
      "description": "Decisions D-S11 and D-S12, rulings R260, R270 and R271: the cohort target per venue, the reachable universe, the shortfall per filter and the fallback steps taken, in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "targets", "reachable", "shortfall", "fallbacks"],
      "properties": {
        "status": { "enum": ["ok", "failed"] },
        "targets": { "type": "object", "additionalProperties": false, "required": ["kalshi_cohorts", "manifold_cohorts", "kalshi_markets", "manifold_markets"], "properties": { "kalshi_cohorts": { "$ref": "#/$defs/nonNegInt" }, "manifold_cohorts": { "$ref": "#/$defs/nonNegInt" }, "kalshi_markets": { "$ref": "#/$defs/nonNegInt" }, "manifold_markets": { "$ref": "#/$defs/nonNegInt" } } },
        "reachable": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegInt" } },
        "shortfall": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonNegInt" } } },
        "fallbacks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["step", "from", "to", "reason"], "properties": { "step": { "enum": ["window_days", "min_trades", "min_traded_bars", "cohort_target"] }, "from": { "type": "integer" }, "to": { "type": "integer" }, "reason": { "type": "string", "maxLength": 2000 } } } }
      }
    }
  },
  "$defs": {
    "audit": { "type": "object", "additionalProperties": false, "required": ["path", "n", "precision_permille"], "properties": { "path": { "type": "string", "pattern": "^audit/[a-z_]+_[0-9a-f]{16}\\.json$" }, "n": { "$ref": "#/$defs/nonNegInt" }, "precision_permille": { "type": "integer", "minimum": 0, "maximum": 1000 } } },
    "scheduleIdList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^([a-z]+-[a-z0-9]+-[0-9]{4}-[0-9]{2}|demo-zero)$" } },
    "ms": { "type": "integer", "minimum": 0 },
    "nonNegInt": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "countMap": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
  }
}
