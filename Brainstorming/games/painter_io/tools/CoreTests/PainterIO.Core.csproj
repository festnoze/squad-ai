<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/Scripts/Core exactly as Unity does (PainterIO.Core.asmdef): netstandard2.1, C# 9, no UnityEngine. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PainterIO.Core</AssemblyName>
    <RootNamespace>PainterIO.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
