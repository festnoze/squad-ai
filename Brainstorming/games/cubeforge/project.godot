; CUBEFORGE - voxel sandbox
; Engine configuration file.

config_version=5

[application]

config/name="CUBEFORGE"
config/description="Voxel sandbox built with Godot 4. Procedural world, no binary assets."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://src/core/game.gd"
Sfx="*res://src/audio/sfx_player.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=0.0

[rendering]

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.42, 0.62, 0.85, 1)

[debug]

settings/stdout/verbose_stdout=false
