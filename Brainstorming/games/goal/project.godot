; GOAL - Seance de tirs au but
; Engine configuration file.

config_version=5

[application]

config/name="GOAL - Seance de tirs au but"
config/description="Jeu de penalty en Godot 4. Gardien pilote par l'application."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://src/core/game.gd"
Shootout="*res://src/core/match_state.gd"
Sfx="*res://src/audio/sfx_player.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="pitch"
3d_physics/layer_2="goal"
3d_physics/layer_3="net"
3d_physics/layer_4="ball"
3d_physics/layer_5="keeper"
3d_physics/layer_6="prop"
3d_physics/layer_7="trigger"
3d_physics/layer_8="target"

[physics]

common/physics_ticks_per_second=120
3d/default_gravity=9.81
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
occlusion_culling/use_occlusion_culling=false
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.10, 1)

[debug]

settings/stdout/verbose_stdout=false
