## GOAL - the imported human figures, and the ONLY file in the project that
## knows a glTF exists.
##
## Everything else in this game is generated by code (`Meshes`, `Tex`, `SfxLib`).
## The two people on screen are the one exception, added after the fact, because
## a keeper is the readable silhouette the whole game hangs on and a body built
## out of capsules and boxes reads as a mannequin at 11 m. `assets/models`
## therefore holds one rigged 31 370 triangle human (CC0, see `assets/CREDITS.md`)
## which this file loads, corrects, colours and poses.
##
## THE RULE THAT GOVERNS THIS FILE: the model is an ENHANCEMENT, never a
## dependency. `available()` is the single guard, it caches its miss, and a
## checkout with no `assets/` folder at all is a fully playable game rendered
## with `Meshes.humanoid_parts()`. Nothing here may push_error on a missing file.
##
## Conventions this file reconciles, all of them MEASURED from the imported scene
## rather than taken on trust:
##
## - The model is authored at 1.80 m with the feet on y = 0 and the root node at
##   scale exactly (1, 1, 1). There is no armature scaled by 100 to undo here,
##   unlike the Quaternius rigs in the sibling CALL OF WAR project, but `build()`
##   still asserts the root scale and re-normalises it if a re-export ever
##   changes that.
## - The figure FACES +Z. The keeper looks towards +Z (contract 1) so he needs no
##   turn; the shooter looks towards -Z so his rig node carries a half turn. That
##   correction lives on the rig node built here and nowhere else.
## - A skinned mesh keeps its BIND pose bounding box, which is a 1.07 x 1.81 x
##   0.47 m box around a standing figure. A keeper at full stretch leaves it, and
##   the renderer would cull him mid dive, which is the single worst frame in the
##   game to lose. `build()` therefore installs a deliberately GENEROUS
##   `custom_aabb`. A tight one is how a character disappears entirely.
## - The rig was exported with IDENTITY rest rotations: every bone's rest basis is
##   the identity and only its translation differs. That is what makes `pose()`
##   simple, because a bone's global basis is then exactly the rotation that
##   carries its rest segment direction onto the wanted one. No per bone basis
##   correction is needed anywhere below.
##
## What the model does NOT ship, stated plainly rather than papered over: no
## animation clips and no albedo texture. The bodies are posed from
## `KeeperBrain.dive_pose`; role-specific kit atlases dress both figures and a
## separate face atlas gives the keeper his fictional identity. Every texture is
## optional and falls back to `Palette` colours when assets/ is absent.
class_name CharacterModels
extends RefCounted

const MODEL_DIR := "res://assets/models"
const PLAYER_FILE := "player.glb"

## Who is being built. The two roles share one file and differ by kit colour,
## sleeve length, glove colour, height and facing.
const ROLE_KEEPER := 0
const ROLE_SHOOTER := 1

## Photorealistic kit atlases. Both share the imported model's UV layout; the
## role decides which uniform is sampled by the jersey, sleeves and shorts.
##
## Paths and not preload(), deliberately. preload() is resolved at PARSE time, so
## a missing file is a parse error that stops this whole script compiling, which
## takes keeper.gd and main.gd down with it and makes available() itself
## uncallable. That breaks the project's core rule: deleting assets/ must leave
## the game playable on its procedural fallbacks, never crash it. These are
## therefore loaded at run time, through a guard, and a missing atlas is only a
## flatter kit.
const KEEPER_KIT_PATH := "res://assets/textures/kits/keeper_kit_albedo.png"
const SHOOTER_KIT_PATH := "res://assets/textures/kits/outfield_kit_albedo.png"
const KEEPER_FRONT_KIT_PATH := "res://assets/textures/kits/keeper_front_albedo.png"
const SHOOTER_FRONT_KIT_PATH := "res://assets/textures/kits/outfield_front_albedo.png"
const KEEPER_SKIN_PATH := "res://assets/textures/characters/keeper_skin_albedo.png"

## Kit atlases already loaded, keyed by path. Loading a texture twice would give
## the two figures separate copies of the same image.
static var _kit_cache: Dictionary = {}


## The kit atlas for a role, or null when the file is absent. Never fatal.
static func kit_texture(keeper: bool) -> Texture2D:
	var path: String = KEEPER_KIT_PATH if keeper else SHOOTER_KIT_PATH
	if _kit_cache.has(path):
		return _kit_cache[path] as Texture2D
	var texture: Texture2D = null
	if ResourceLoader.exists(path):
		texture = load(path) as Texture2D
	_kit_cache[path] = texture
	return texture


## Number-free front of the jersey. The numbered atlas above is kept for the
## back and for the shorts, where a squad number belongs.
static func front_kit_texture(keeper: bool) -> Texture2D:
	var path: String = KEEPER_FRONT_KIT_PATH if keeper else SHOOTER_FRONT_KIT_PATH
	if _kit_cache.has(path):
		return _kit_cache[path] as Texture2D
	var texture: Texture2D = null
	if ResourceLoader.exists(path):
		texture = load(path) as Texture2D
	_kit_cache[path] = texture
	return texture


## Photographic face/skin atlas for the keeper, or null in the asset-free
## fallback configuration. It shares the same guarded cache as the kit atlases.
static func keeper_skin_texture() -> Texture2D:
	if _kit_cache.has(KEEPER_SKIN_PATH):
		return _kit_cache[KEEPER_SKIN_PATH] as Texture2D
	var texture: Texture2D = null
	if ResourceLoader.exists(KEEPER_SKIN_PATH):
		texture = load(KEEPER_SKIN_PATH) as Texture2D
	_kit_cache[KEEPER_SKIN_PATH] = texture
	return texture

## On screen heights, metres. The keeper is the taller of the two, which matches
## the 1.88 m the procedural `Meshes.humanoid_parts()` is sized for, and the
## shooter is the 0.97 of it that `Shooter.BODY_SCALE` has always applied.
const KEEPER_HEIGHT := 1.88
const SHOOTER_HEIGHT := 1.82

## How much bigger than life the head is drawn, on BOTH figures.
##
## The game is played from behind the taker with his shoulders filling the bottom
## of the screen and the keeper eleven metres away, eighty pixels tall. At that
## size a correctly proportioned head is a thumbnail, and the two people on screen
## read as mannequins. A doubled head is the same trick a caricature uses: it puts
## the face, which is the only part of a body that carries an expression, at a
## size the player can actually see. It also sets the register of the whole
## render, which is why the bodies below are shaped BLOCKY rather than realistic.
const HEAD_SCALE := 2.0
## Kept as the name the keeper was built with. Both figures now use it.
const KEEPER_HEAD_SCALE := HEAD_SCALE

## WHERE THE ENLARGED HEAD IS SCALED FROM, and the whole of why this exists.
##
## `set_bone_pose_scale` scales a bone's geometry about the bone's OWN ORIGIN, and
## the head joint of this rig sits at y = 1.636, which is inside the skull at about
## ear height: 0.164 of head above it and 0.072 of jaw below it. Doubling about
## that point therefore drove the jaw DOWN by 7.2 cm as surely as it raised the
## crown by 16.4. The chin landed at y = 1.491, below the base of the neck
## (y = 1.519) and well inside the shirt, whose collar was cut against a body with
## a life sized head. What it looked like was measured at close range on both
## figures: a jaw drawn in front of the collar, a wedge of neck skin pinched out
## beside it, and no neck at all from the front.
##
## The pivot is therefore moved to the FLOOR OF THE SKULL, which is measured off
## the mesh (see `_head_floor`) rather than typed in. The head then grows upwards
## and outwards only, the chin comes back exactly where the file drew it, and the
## collar that was cut for it fits it again. `_NECK_SHOW` then lifts the whole
## skull a little further so that the neck the source model does have is actually
## visible between the jaw and the collar instead of resting on it.
##
## The figure gets taller by (HEAD_SCALE - 1) x the height of the skull. That is
## the honest price of a caricature head and it is paid at the CROWN, never at the
## feet: `pose()` places the rig from the hips, so nothing here can lift a boot off
## the turf.
const _NECK_SHOW := 0.026
## Share of a vertex's skin weight that has to belong to the head bone before the
## vertex counts as skull rather than as neck. Deliberately near one: a vertex the
## neck still owns a tenth of is a vertex the neck will drag, and using it as the
## pivot would put the pivot below the jaw.
const _HEAD_OWNED := 0.999

## Bone names of the source rig. Grouped here so a re-export that renames
## anything fails loudly in one place instead of silently posing nothing.
const BONE_ROOT := "root"
const BONE_SPINE: PackedStringArray = ["spine04", "spine03", "spine02", "spine01"]
const BONE_NECK: PackedStringArray = ["neck01", "neck02", "neck03", "head"]

## Segment table: bone -> the bone that marks the far end of its segment. The
## far end is the JOINT the segment runs to, never the next twist bone, so
## aiming `upperarm01` really aims the whole upper arm and its twist bone follows.
const _SEGMENTS := {
	"upperarm01.L": "lowerarm01.L",
	"lowerarm01.L": "wrist.L",
	"wrist.L": "finger2-1.L",
	"upperleg01.L": "lowerleg01.L",
	"lowerleg01.L": "foot.L",
	"foot.L": "toe2-2.L",
	"upperarm01.R": "lowerarm01.R",
	"lowerarm01.R": "wrist.R",
	"wrist.R": "finger2-1.R",
	"upperleg01.R": "lowerleg01.R",
	"lowerleg01.R": "foot.R",
	"foot.R": "toe2-2.R",
}

## Which pose key drives which segment, and from where. Read as
## `bone: [from_key, to_key]`, both world space points supplied by the caller.
const _AIMS := {
	"upperarm01.L": ["shoulder_l", "elbow_l"],
	"lowerarm01.L": ["elbow_l", "wrist_l"],
	"wrist.L": ["wrist_l", "glove_l"],
	"upperleg01.L": ["hip_l", "knee_l"],
	"lowerleg01.L": ["knee_l", "ankle_l"],
	"foot.L": ["ankle_l", "toe_l"],
	"upperarm01.R": ["shoulder_r", "elbow_r"],
	"lowerarm01.R": ["elbow_r", "wrist_r"],
	"wrist.R": ["wrist_r", "glove_r"],
	"upperleg01.R": ["hip_r", "knee_r"],
	"lowerleg01.R": ["knee_r", "ankle_r"],
	"foot.R": ["ankle_r", "toe_r"],
}

## Order the aims are applied in. A dictionary keeps insertion order in GDScript,
## but the parent of a bone must be posed before the bone itself, so the order is
## written down rather than inherited from a literal.
const _AIM_ORDER: PackedStringArray = [
	"upperarm01.L", "lowerarm01.L", "wrist.L",
	"upperarm01.R", "lowerarm01.R", "wrist.R",
	"upperleg01.L", "lowerleg01.L", "foot.L",
	"upperleg01.R", "lowerleg01.R", "foot.R",
]

## Bones that carry part of the limb's rotation so the shoulder and the hip
## deform with it. A single bone taking the whole swing collapses the deltoid
## and the glute into a crease the moment the arm leaves the bind pose, which on
## a keeper at full stretch is the only moment anybody is looking.
##
## Every bone listed as a KEY here is also pinned: its global position is written
## from the joint the caller solved rather than left to forward kinematics, so
## the share taken by the parent cannot move the shoulder or the hip by a
## millimetre. Only the stub between the two stretches, and that stub lives
## inside the chest and the pelvis where nothing sees it.
const _SHARED_WITH := {
	"upperarm01.L": "shoulder01.L",
	"upperarm01.R": "shoulder01.R",
	"upperleg01.L": "pelvis.L",
	"upperleg01.R": "pelvis.R",
}
const _SHARE := 0.35

## How far past its rest length an arm bone may be drawn, and how much of the
## shortfall the shoulder girdle absorbs instead. See `_relax_arms`.
##
## `Keeper` solves its arms against `KeeperBrain.dive_pose`, which can ask for a
## glove further from the shoulder than the arm is long, and it covers the gap by
## SCALING the two arm bones, up to 30 percent (`Keeper.MAX_STRETCH`). Pinning
## reproduces that faithfully, and 30 percent of a 51 cm arm is 15 cm of skin
## stretch: at full dive extension the keeper grew rubber arms and a hand hanging
## off the end of them. Twelve percent is the most a shoulder, an elbow and a
## sleeve absorb before the eye calls it wrong.
##
## The rest of the reach is taken somewhere real. A shoulder girdle genuinely does
## travel several centimetres towards the hand at full stretch (the scapula slides
## across the ribs), so the arm ROOT is allowed to slide that far along the line to
## the glove, and the clavicle carries most of it so the deltoid travels with it
## rather than tearing off the chest. What neither of those can pay for is left
## unpaid, on purpose: a keeper who cannot reach the ball should be drawn not
## reaching it. That is the whole drama of a penalty.
##
## THIS CHANGES NO SAVE. `KeeperBrain.try_save` is tested against the pose the
## brain built, never against the drawn skeleton, and the balance is measured on
## that pose. This is a rendering correction and nothing else.
const _ARM_STRETCH_MAX := 1.12
## Smallest elbow flexion the figure is ever drawn with, radians. See
## `_unlock_elbows` for what it costs, which is almost nothing.
const _ELBOW_MIN_BEND := 0.122      # seven degrees
## In the model's own units, so about 6 cm at the keeper's on screen scale.
const _GIRDLE_GIVE := 0.058
## Share of the girdle slide the clavicle carries. The rest is stretch across the
## trapezius, which is a shrug, which is what a diving keeper's shoulder does.
const _GIRDLE_CLAVICLE := 0.65

## How far each shell of the kit is pushed off the body in the shader, in the
## model's own units.
##
## The kit is a proxy shell already modelled 6 mm outside the skin, which is
## enough at the bind pose and NOT enough once the body is posed: the shell and
## the body carry their own skin weights and drift apart under a hard shoulder
## rotation, and the body then pokes through the shirt as a stipple of skin
## coloured pixels. Growing the shell and shrinking the skin gives the pair a
## full centimetre of clearance that follows the deformation, because `grow`
## happens after skinning rather than before it.
const _KIT_GROW := 0.006
const _SKIN_SHRINK := -0.004

## The garment UVs occupy a compact rectangle in the source MakeHuman atlas.
## The dedicated kit images are authored as a full-frame crop of that rectangle
## with an 18 px guard band on the 768 px UV reference. The material transform
## below expands the packed coordinates back onto that crop. Without it every
## garment samples the atlas's black background.
const _KIT_UV_MIN := Vector2(0.813577, 0.011485)
const _KIT_UV_MAX := Vector2(0.875866, 0.068663)
const _KIT_UV_MARGIN := 18.0 / 768.0

## THE HAIR, and why it is a shell of the skull rather than a ball on top of it.
##
## The figure ships no hair, and MakeHuman's UV atlas carries no way to paint any
## on, so a cap is added here: two identical bald heads is the one way this model
## looks WORSE than the boxes it replaces.
##
## That cap used to be a squashed sphere hung off the head bone, and measuring the
## skull says exactly why it read as a wig. In the head bone's own frame the crown
## is 0.164 above the joint, the skull is widest (0.095) at 0.030, its back is at
## z = -0.060 and its forehead at z = +0.148, so the cranium is centred near
## z = +0.044. The sphere was centred at z = -0.008: five centimetres BEHIND the
## skull it was supposed to cover. It therefore overhung the back of the head by
## seven centimetres, its front stopped at z = +0.087 while the forehead runs out
## to z = +0.148, and the band of scalp between the two was the bare strip an
## audit found on both figures. Its widest ring also stood clear of the skull, so
## where it did meet the head it met it as an edge rather than as a hairline.
##
## No scaled sphere fixes that. An ellipsoid whose equator is high enough to be
## short hair is an ellipsoid whose equator stands three centimetres proud of a
## skull that is narrowing towards the crown: a brim. So the cap is now the
## SKULL'S OWN TRIANGLES, pushed out along their own normals, which follows the
## head by construction at any re-export and cannot overhang it anywhere.
##
## Two numbers do all the work, and both are read off the shell rather than set on
## it:
##  - `_HAIR_THICK` is how far the hair stands above the scalp at the crown. The
##    drawn skin sits `_SKIN_SHRINK` inside its own geometry, so the standoff the
##    eye sees is `_HAIR_THICK - _SKIN_SHRINK` = 11 mm, against 22 mm for the old
##    sphere: the height of the hair is exactly halved, which is what was asked
##    for, and it now lies flat to the skull instead of perching on it.
##  - the offset FALLS through the drawn skin at the hairline, `_HAIR_BITE` under
##    it, so the rim of the cap is buried in the scalp and the visible hairline is
##    the curve where the two surfaces cross. A boundary that is an intersection
##    cannot show a hard edge, and it cannot leave a gap either.
##
## `_HAIR_BITE` is not a taste, it is arithmetic. The cranium of this mesh is a
## hundred vertices, so a triangle edge across it is around 25 mm, and a flat
## triangle strung across a skull of radius 90 mm sags about 0.9 mm below the
## surface in its middle. A bite smaller than that sag lets the scalp come back
## through the cap between two vertices, which draws the hairline as a row of
## scallops. `_HAIR_FEATHER` is the other half of the same sum: the crossing can
## only wander by the sag divided by the slope of the offset, so a short feather
## is what keeps the hairline a line.
##
## The hairline itself is measured by AZIMUTH about the cranium, not by height:
## high across the forehead, dropping round the temple, a little back up at the
## nape, which is where a real one runs. All three drops are fractions of the
## measured skull height, never centimetres, so a re-exported head keeps its own
## hairline. Its lowest point sits at 0.56 of the skull height where the old
## sphere reached 0.23, which is the vertical extent of the cap halved a second
## time and the reason it no longer reads as a helmet from behind. Triangles below
## the line are kept for `_HAIR_BURY` of skull height so the crossing curve always
## falls inside geometry that exists.
## Metres in the model's own units.
const _HAIR_THICK := 0.007
const _HAIR_BITE := 0.0025
## Fractions of the skull height above the head joint.
const _HAIR_FEATHER := 0.09
const _HAIR_DROP_FRONT := 0.366
const _HAIR_DROP_SIDE := 0.439
const _HAIR_DROP_BACK := 0.415
const _HAIR_BURY := 0.13
## Height, as a fraction of the skull, above which the head is cranium rather than
## jaw and nose. The z centre the hairline tilts about is measured there, so the
## nose cannot drag it forwards.
const _HAIR_CRANIUM := 0.35
const _EYE_X := 0.035
const _EYE_Y := 0.033
const _EYE_Z := 0.126

## THE HAND, and why the model's own one is not used.
##
## MakeHuman ships an anatomical hand with five separate fingers, splayed, each
## about 8 cm long and 1.2 cm thick. Painted glove orange and seen from two and a
## half metres it reads as a claw, and it is the same claw on both figures because
## they share the mesh. A keeper's glove is the opposite object: a broad flat pad
## with the fingers inside it and no gaps between them.
##
## So the hand surface is switched off (`_kit_material`) and one solid is hung off
## each wrist instead: a flattened ellipsoid, laid in the hand's own measured frame
## (`_measure_hand`), padded for the keeper and shorter and rounder for the taker,
## whose bare hands are closed as he runs. A `BoneAttachment3D` carries it exactly
## as it carries the hair, so it follows the posed wrist for free.
##
## Sizes are FRACTIONS of the hand this file measured, never centimetres, so a
## re-exported model is still covered by its own glove. Read as
## [half across the palm, half through the palm, half along the fingers], the first
## two in units of the measured hand radius and the third of its length.
##
## THE KEEPER'S GLOVE IS A PAD AND NOT AN EGG, and the middle number is the whole
## of that. It used to be 0.44, which on this hand is 42 mm of half thickness: a
## solid 128 mm across, 85 mm thick and 200 mm long is very nearly an ellipsoid of
## revolution, and a close up of a save showed exactly that, a smooth orange egg
## floating beside the ball. A real glove is 100 mm across, 40 mm thick and
## 210 mm long, which is what these fractions now give.
##
## The measured hand is SPLAYED - MakeHuman ships it with the fingers apart - so
## `_hand_radius` is the reach out to a spread thumb, near 96 mm, and every
## fraction here is read against that and not against a palm.
const _MITT_KEEPER := Vector3(0.52, 0.20, 0.50)
const _MITT_SHOOTER := Vector3(0.52, 0.46, 0.34)
## Where the solid is centred, as a fraction of the wrist to hand centre distance
## `hand_reach`. The keeper's glove reaches out past the knuckles; a closed fist
## sits back against the wrist.
##
## The keeper's fraction is not a taste either: a glove `along` long whose centre
## sits closer to the wrist than `along` starts BEHIND the wrist and swallows the
## end of the forearm, which is what put a bare gap between the sleeve cuff and
## the glove on that same close up. 0.82 of `hand_reach` is `along` out from the
## wrist, so the heel of the glove lands on the wrist and the two meet.
##
## `hand_reach` itself is NOT touched. It is what `Keeper` and `Shooter` solve
## their arms against and what decides where the drawn glove ends up, so moving it
## would move the reach the difficulty is tuned to. The solid is drawn around that
## point instead, and both fractions keep it well inside the mitt.
const _MITT_REACH_KEEPER := 0.82
const _MITT_REACH_SHOOTER := 0.42

## Every surface of the kit shell, as opposed to the body under it.
const _KIT: PackedStringArray = [SURFACE_JERSEY, SURFACE_SLEEVES, SURFACE_SHORTS,
	SURFACE_SOCKS, SURFACE_BOOTS]

## The three garments that are cut out of the ONE torso shell.
##
## The kit shell is exactly THREE connected pieces: the torso piece (which has
## to become a shirt, two sleeves and a pair of shorts) and one piece per lower
## leg (which carries its own sock to boot boundary and keeps it). Only the
## torso piece is re-split. See `_recut_kit` for what was wrong with the split
## the file ships.
const _POOL: PackedStringArray = [SURFACE_JERSEY, SURFACE_SLEEVES, SURFACE_SHORTS]

## Shirt hem above the hip midpoint, in the model's own units. The hem is a
## HORIZONTAL PLANE and the shell is cut on it exactly, so the hem is a straight
## line all the way round instead of a row of triangles voting on which garment
## they belong to.
const _HEM_RISE := 0.065

## Where the short sleeve ends, as a fraction of the shoulder to elbow distance
## measured along the shoulder to wrist axis. 0.6 puts it on the lower bicep,
## which is where an outfield shirt stops. The plane is built once on the +X arm
## and MIRRORED onto -X, so the two sleeves are guaranteed identical rather than
## merely similar: the asymmetry of the old cut came from left and right bone
## weights differing in the sixth decimal.
const _SLEEVE_FRACTION := 0.60

## How far below the neck joint an open edge still counts as part of the collar.
## It has to clear the worst tooth (5 cm on this file) without reaching the
## cuffs, which are 34 cm lower.
const _COLLAR_BAND := 0.15
## How much the neck slab grows per step while it hunts for the size that
## swallows every tooth, and how many steps it may take before giving up.
const _COLLAR_MARGIN := 0.003
const _COLLAR_TRIES := 40
## Radius of the two lower corners of the neck slab. Without it the collar has
## two right angles in it, which no shirt does.
const _COLLAR_ROUND := 0.050
## How fast the neckline climbs once it is past the neck, in metres of rise per
## metre out. See `_inside_collar`.
const _COLLAR_RISE := 0.45
## Half width of the column of x the collar edge is measured in, and how far under
## that edge the face to body seam is buried. See `_split_face_surface`.
const _COLLAR_COLUMN := 0.10
const _FACE_SEAM_DROP := 0.055

## How far below the hip joints an open edge counts as the leg hole of the
## shorts rather than as part of the waist.
const _SHORTS_BAND := 0.10

## Quantisation of a vertex position, in units of the model, used to recognise
## that two triangles from two different source primitives share one edge.
## 0.05 mm: finer than any two distinct vertices of this mesh, coarser than any
## rounding the exporter did.
const _WELD := 20000.0

## Half width of the band around a cut in which a vertex counts as sitting ON
## the cut. Without it a cut that grazes an existing vertex spawns a sliver
## triangle of three coincident points, which is a degenerate the renderer keeps
## and nobody can see to debug.
const _CLIP_EPSILON := 1.0e-5

## --- THE FIGURES READ AS MEN, and this block is where that is decided. --------
##
## The source is the CC0 MakeHuman BASE mesh, which is deliberately androgynous,
## and measuring it says exactly why it lands on the feminine side of neutral. In
## the model's own units, half widths of the torso with the arms excluded:
##
##     hips  y = 0.95 -> 0.199      seat  y = 0.85 -> 0.224
##     waist y = 1.17 -> 0.152      chest y = 1.30 -> 0.162
##
## The widest part of this body is the PELVIS, and the chest is a third narrower
## than it. That single ratio is what an eye reads as female, ahead of the face,
## the hair and everything else. On top of it the shoulders SLOPE: there is no
## shelf across the top, the outline just runs off down the arm.
##
## The correction is a BIND POSE SHAPING PASS, run once over the imported mesh
## before the garment seams are re-cut, and NOT a set of bone pose scales. Both
## reasons were the deciding ones:
##
##  - a bone's pose scale propagates to its CHILDREN. Widening a clavicle inflates
##    the whole arm hanging off it and thickening a spine bone inflates the head,
##    so every one needs a counter scale, and those counter scales land on the very
##    joints `pose()` writes from the inverse kinematics.
##  - the shaping has to hit SEVEN SURFACES identically. The kit is a shell
##    modelled 6 mm outside the skin (see `_KIT_GROW`); deform the skin by a
##    different amount than the shell and the body comes through the shirt as a
##    stipple of skin coloured pixels. A pure function of the bind position is
##    identical on both BY CONSTRUCTION, which is a guarantee no per surface edit
##    can offer. Every surface goes through the same `_shape()`.
##
## THE INVARIANT, and `tests/test_character_models.gd` guards it: `_shape` never
## touches Y. Only x and z ever move. Every height this file depends on (the shirt
## hem, the collar band, the sock top, the sole drop the whole rig stands on, the
## figure's own height, and therefore the role scale) is bit for bit what it was,
## so no amount of reshaping can put a boot in the turf or a hem on a knee.
##
## Half width multiplier against height, in the model's own units. Interpolated
## with a smoothstep between knots and not with a straight line: a piecewise
## linear profile has a kink at every knot, and a kink in the profile is a crease
## in the shading.
## Two rules govern the numbers, and both were learned by measuring a render.
##
## FIRST, the profile scales x about the MIDLINE, so at a height where the body is
## two legs it pushes the legs APART instead of making either of them thicker. The
## shorts hang across exactly such a height, and the shorts hem is what an eye
## compares the shoulders against: every tenth added down there is a tenth taken
## off the V. So below the waist this curve stays at or under one, and all the leg
## bulk comes from `_LIMB_PLAN`, which pushes about each limb's OWN axis.
##
## SECOND, a shoulder is read as SQUARE or as SLOPING by the slope of the outline,
## which is `x'(y) * w(y) + x(y) * w'(y)`. The body's own `x'` is what makes the
## shipped figure slope; the second term is the only handle this map has on it, and
## it is positive only while `w` is still CLIMBING. So the curve keeps rising to
## the very top of the trapezius (1.48) and only then falls away into the neck.
## A curve that peaked at the chest and eased off would have widened the figure
## without ever squaring the shoulder.
const _WIDTH_PROFILE: PackedVector2Array = [
	Vector2(0.00, 1.00),      # boots, untouched
	Vector2(0.12, 1.02),
	Vector2(0.34, 1.04),      # calf: the bulk is the limb plan's job, not this
	Vector2(0.52, 1.01),
	Vector2(0.72, 0.98),      # the legs are drawn IN, which is half of the V
	Vector2(0.88, 0.91),      # seat, in
	Vector2(1.02, 0.90),      # pelvis, the narrowest point of the new body
	Vector2(1.16, 1.06),      # waist straight rather than pinched
	Vector2(1.26, 1.22),
	Vector2(1.34, 1.36),      # chest broad
	Vector2(1.42, 1.48),      # the pectoral shelf
	Vector2(1.48, 1.52),      # the top of the deltoid, and the peak of the curve
	Vector2(1.51, 1.46),
	Vector2(1.545, 1.36),     # neck thick: a doubled head needs one
	Vector2(1.575, 1.22),
	Vector2(1.61, 1.10),      # jaw wide: a heavy jaw is half of reading as a man
	Vector2(1.66, 1.05),
	Vector2(1.72, 1.00),      # the cranium is left alone, HEAD_SCALE owns it
	Vector2(1.90, 1.00),
]

## Depth multiplier against height, about `_DEPTH_CENTRE`. A broad chest that is
## not also a little deeper reads as a plank.
const _DEPTH_PROFILE: PackedVector2Array = [
	Vector2(0.00, 1.00),
	Vector2(0.52, 1.02),
	Vector2(0.78, 1.00),
	Vector2(0.92, 0.95),      # flatter seat
	Vector2(1.06, 0.95),
	Vector2(1.20, 1.02),
	Vector2(1.34, 1.14),      # deeper chest
	Vector2(1.46, 1.17),
	Vector2(1.51, 1.14),
	Vector2(1.56, 1.09),      # thick neck
	Vector2(1.62, 1.02),
	Vector2(1.68, 1.00),
	Vector2(1.90, 1.00),
]
## Roughly the spine line: the depth scale opens the chest forwards and the back
## backwards around it instead of pushing the whole torso off its own skeleton.
const _DEPTH_CENTRE := 0.02

## Limbs the pass thickens, each measured off the rest skeleton and mirrored onto
## the +X half. Read as
##   [from bone, to bone, gain, t from, t to, falloff radius].
## `gain` is the peak fraction the limb's radius grows by and the falloff radius
## is the scale of the GAUSSIAN bell it grows under. The two `t` values fence the
## segment off the joint at each end, so inflating a thigh cannot also inflate the
## pelvis it hangs from. Every number was read off this mesh with a probe.
##
## The bell is not decoration, and the shape it replaced is why. A limb thickened
## by `r -> r * (1 + gain * w(r))` with `w` a smoothstep between two radii has a
## RADIAL DERIVATIVE of `1 + gain*w + gain*r*w'`, and a smoothstep 5 cm wide has
## |w'| up to 30 per metre: that term alone is -0.45, two overlapping limbs took
## it to -0.77, and the map ended up squashing a 6 mm shell offset down to 1.4 mm.
## That is the body coming through the shirt, arrived at by arithmetic rather than
## by looking, and `tests/test_character_models.gd` measures it.
##
## A gaussian has no such knee. For `f(r) = gain * r * exp(-(r/R)^2)` the most
## negative `f'` is exactly `-0.446 * gain`, whatever R is, so the radial
## derivative can never fall below `1 - 0.446 * gain` and the clearance floor is a
## property of the formula instead of a value somebody has to keep re-checking.
const _LIMB_PLAN: Array = [
	["upperarm01.L", "lowerarm01.L", 0.40, 0.06, 1.00, 0.090],
	["lowerarm01.L", "wrist.L", 0.30, 0.00, 1.00, 0.072],
	# The hand is not drawn any more (see `_MITT_KEEPER`), so it is inflated only
	# enough to keep `hand_reach` where the arms are solved against it, and no
	# further: its own gaussian was the worst point in the whole clearance map and
	# there is nothing left there to look at.
	["wrist.L", "finger2-1.L", 0.06, 0.00, 1.00, 0.080],
	["upperleg01.L", "lowerleg01.L", 0.38, 0.34, 1.00, 0.130],
	["lowerleg01.L", "foot.L", 0.28, 0.00, 0.88, 0.105],
]
## Width, in units of a limb's own length, of the smoothstep that tapers its
## inflation off at a fenced end. Wide on purpose: this taper is a gradient ALONG
## the limb, and a short one is the same cliff the radial falloff used to be.
const _LIMB_TAPER := 0.38

## Where the width profile stops being a TORSO profile. It has to run all the way
## out to the shoulder joint, because that is what builds the deltoid shelf, and it
## has to be gone by the elbow: the profile is applied in the BIND pose, a bind
## pose offset is carried RIGIDLY by the bone that owns it, so an offset left on
## the forearm would displace the drawn glove away from the glove the save test
## uses. Measured against the shoulder to wrist axis, so it follows the arm rather
## than a height band.
##
## Both bands are deliberately WIDE. This fade multiplies a profile that is 22
## percent off unity at a point 30 cm off the midline, so its own gradient shows
## up in the map as `|x| * (profile - 1) * d(fade)/ds`: a narrow band turns a
## gentle reshaping into a local squash, which is the same arithmetic that broke
## the limb falloff (see `_LIMB_PLAN`) and it is measured by the same test.
const _ARM_FADE_NEAR := 0.080
const _ARM_FADE_FAR := 0.260
const _ARM_FADE_FROM := 0.10
const _ARM_FADE_TO := 0.60

## Step of the finite difference that recovers the shaping's Jacobian, in the
## model's own units. Big enough to stay clear of float noise on a 0.5 mm mesh,
## small enough that the profile is straight across it.
const _JACOBIAN_STEP := 0.0015

## The bind pose box of this mesh is a standing figure. This one is the envelope
## of a keeper at full horizontal stretch, in the model's own units, and it is
## deliberately far larger than any pose can reach: over rendering two characters
## costs nothing, a character culled in the middle of a save costs the shot.
const CULL_BOX := AABB(Vector3(-2.0, -1.6, -2.0), Vector3(4.0, 4.6, 4.0))

## Alpha written into the albedo of a surface that is switched off. Paired with
## `TRANSPARENCY_ALPHA_SCISSOR` at 0.5 every fragment is discarded, which is a
## real hide rather than a blended ghost, and Godot has no per surface
## visibility flag to do it any other way.
const _HIDDEN_ALPHA := 0.0

## Surface names of the source mesh, in the order Godot reports them. Matching is
## done by `Material.resource_name`, never by index, so a re-export that reorders
## the primitives cannot silently repaint the boots in jersey lime.
const SURFACE_SKIN := "skin"
const SURFACE_FACE := "face"
const SURFACE_HANDS := "gloves_or_skin"
const SURFACE_JERSEY := "jersey"
const SURFACE_JERSEY_FRONT := "jersey_front"
const SURFACE_JERSEY_BACK := "jersey_back"
const SURFACE_SLEEVES := "sleeves_long"
const SURFACE_SHORTS := "shorts"
const SURFACE_SOCKS := "socks"
const SURFACE_BOOTS := "boots"

static var _scene_cache: Dictionary = {}
static var _probed := false
static var _model_metrics: Dictionary = {}
static var _rest_dirs: Dictionary = {}
static var _rest_spans: Dictionary = {}
## The imported mesh with the garment seams re-cut. Built once, shared by both
## figures: the two roles differ only by the materials laid over it.
static var _kit_mesh: ArrayMesh = null
## The hair cap, cut from the skull of the mesh above. Built once, shared by both
## figures for the same reason `_kit_mesh` is.
static var _hair_cap: ArrayMesh = null
## The imported mesh with the burly shaping baked in, before the seams are re-cut.
## Kept apart from `_kit_mesh` so that a re-cut which gives up (a missing garment
## surface) still hands the caller a SHAPED body rather than the raw import.
static var _shaped_mesh: ArrayMesh = null
## `_LIMB_PLAN` resolved against the rest skeleton, plus the shoulder to wrist axis
## the width profile fades out along. Empty until `_build_shape_frame` has run,
## and `_shape()` is the identity while it is empty, which is what keeps every
## measurement below correct in the order it happens to be taken.
static var _limbs: Array = []
static var _arm_root := Vector3.ZERO
static var _arm_dir := Vector3.ZERO
static var _arm_span := 0.0
## How far the head bone is lifted along the neck before it is scaled, in the
## model's own units. Measured once in `_measure`, see `_NECK_SHOW`.
static var _head_rise := 0.0
## Lowest point of the geometry the head bone owns outright: the jaw line, and the
## point the enlarged skull is scaled about.
static var _skull_floor := 0.0
## Which SKIN BIND indices mean the head bone. `ARRAY_BONES` indexes the skin's
## bind list and not the skeleton, so this is the only honest way to ask a vertex
## how much of it belongs to the head. See `_free_head_grip`.
static var _head_binds: Dictionary = {}
## The hand frame, on the +X side, in the model's own units: the direction the
## fingers run in, the palm normal, and the two sizes the mitt is cut from. All
## four are measured off the mesh in `_measure`, so a re-exported hand is still
## covered by its own glove. See `_add_mitts`.
static var _hand_axis := Vector3.ZERO
static var _hand_normal := Vector3.ZERO
static var _hand_length := 0.0
static var _hand_radius := 0.0


## True when a model is installed and loadable for this role. Cached, misses
## included, so an asset-less checkout costs one filesystem probe for the whole
## session and never one per frame.
static func available(role: int) -> bool:
	return _scene(role) != null


## Builds one figure, or returns null when no model is installed, which is the
## caller's cue to keep its procedural body.
##
## The returned node is a plain `Node3D` carrying, in this order, every
## correction the model needs: the uniform scale that brings it to the role's
## height, the yaw that turns it to the direction the role faces, the generous
## `custom_aabb` that keeps it alive through a dive, and the seven kit materials.
## Nothing downstream has to know any of that happened.
static func build(role: int) -> Node3D:
	var scene := _scene(role)
	if scene == null:
		return null
	var metrics_data := metrics(role)
	if metrics_data.is_empty():
		return null

	var rig := Node3D.new()
	rig.name = "ModelRig"
	rig.set_meta(&"role", role)
	# The shooter looks towards -Z (contract 1), the model is authored facing +Z.
	# This is the resting facing only: `pose()` drives the whole transform from
	# world space afterwards, so it stays correct either way.
	if role == ROLE_SHOOTER:
		rig.rotation.y = PI
	var k := float(metrics_data.get("scale", 1.0))
	rig.scale = Vector3(k, k, k)

	var model := scene.instantiate() as Node3D
	if model == null:
		return null
	model.name = "Model"
	# A re-export that reintroduced a centimetre armature would land here. The
	# measured factor already went into `k`, so anything left on the root is a
	# second multiplication and has to go.
	if not model.scale.is_equal_approx(Vector3.ONE):
		push_warning("CharacterModels: model root scale is %s, normalising it." % str(model.scale))
		model.scale = Vector3.ONE
	rig.add_child(model)

	var mesh_instance := _find_mesh(model)
	if mesh_instance == null:
		push_warning("CharacterModels: the model carries no MeshInstance3D.")
		return rig
	var skeleton := _find_skeleton(model)
	# The garment seams the file ships are ragged and asymmetric, so they are
	# re-cut here, once, before anything is painted. See `_recut_kit`. This has
	# to happen while the node is still OUT of the tree: `skin` and
	# `skeleton_path` are properties of the MeshInstance3D rather than of the
	# mesh, and they are resolved into a live binding on entering the tree.
	if skeleton != null:
		# Two passes over the mesh, in this order and only this order. The shaping
		# is what turns the androgynous base mesh into two burly men (see
		# `_WIDTH_PROFILE`); the re-cut then measures the ragged garment openings
		# off the body it is actually going to dress, so a broader chest widens its
		# own collar instead of wearing the collar of the body it used to be.
		var shaped := _shaped_body(mesh_instance.mesh, skeleton)
		if shaped != null:
			mesh_instance.mesh = shaped
		var recut := _recut_kit(mesh_instance.mesh, skeleton)
		if recut != null:
			mesh_instance.mesh = recut
	# The bind pose box is a standing figure and a diving keeper leaves it.
	mesh_instance.custom_aabb = CULL_BOX
	# Two characters at 31 k triangles is a rounding error next to the stadium,
	# and a keeper with no shadow floats.
	mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	_paint(mesh_instance, role)

	if skeleton == null:
		push_warning("CharacterModels: the model carries no Skeleton3D, it will not pose.")
	else:
		rig.set_meta(&"skeleton", skeleton)
		_add_hair(skeleton, mesh_instance.mesh)
		_add_eyes(skeleton)
		_add_mitts(skeleton, role)
	rig.set_meta(&"scale", k)
	rig.set_meta(&"anchor", metrics_data.get("anchor", Vector3.ZERO))
	return rig


## Everything a caller needs to size its own rig to the model, in metres, at the
## role's final on screen scale. Empty when no model is installed.
##
## All of it is measured from the imported skeleton and mesh at load time, never
## hardcoded, so a re-exported model cannot silently drift away from the inverse
## kinematics that drive it.
##
## The anchor of every figure is the HIP MIDPOINT, not the pelvis bone: the
## source rig puts its root at the sacrum, 9.5 cm behind the hip joints, whereas
## `KeeperBrain.dive_pose` reports a body centre. Measuring from the hips makes
## the two agree to within 2.5 mm and removes the forward offset entirely.
##
## Keys, all floats unless stated:
##   "scale"          the uniform factor applied to the imported model
##   "height"         standing height, metres
##   "hip_height"     the anchor above the feet
##   "shoulder_half"  half the distance between the two shoulder joints
##   "shoulder_rise"  shoulder joint above the anchor
##   "hip_half"       half the distance between the two hip joints
##   "torso"          anchor to the base of the neck
##   "head_lift"      base of the neck to the head joint
##   "head_rise"      how far the DRAWN skull sits above that joint, because the
##                    enlarged head is scaled about its jaw and not about the joint
##                    (see `_NECK_SHOW`). Add it to any target measured off the
##                    head joint that has to land ON the head.
##   "upper_arm"      shoulder joint to elbow
##   "fore_arm"       elbow to wrist
##   "hand_reach"     wrist to the CENTRE of the hand
##   "thigh"          hip joint to knee
##   "shin"           knee to ankle
##   "foot_reach"     ankle to the CENTRE of the boot
##   "sole_drop"      ankle to the underside of the boot
##   "anchor"         Vector3, the anchor in the model's own unscaled units
static func metrics(role: int) -> Dictionary:
	if _scene(role) == null:
		return {}
	if _model_metrics.is_empty():
		return {}
	var k := _role_scale(role)
	var out: Dictionary = {}
	for key in _model_metrics:
		var value: Variant = _model_metrics[key]
		if typeof(value) == TYPE_FLOAT:
			out[key] = float(value) * k
		else:
			out[key] = value
	out["scale"] = k
	return out


## The padded glove `_add_mitts` hangs off each wrist, in the DRAWN units of
## `role`, so a caller that has to keep a held ball OFF it can measure the solid
## instead of guessing at it.
##
##   "along"   semi axis down the fingers
##   "girth"   the larger of the two semi axes across the palm, which is the one a
##             ball resting against the SIDE of the glove meets
##   "back"    how far the CENTRE of the solid sits behind the hand centre the arms
##             are solved to, along the same axis
##
## That last number is the whole reason this function exists. `_add_mitts` centres
## the glove at `_MITT_REACH_*` of `hand_reach` while the arm solve aims at the
## full `hand_reach`, so the solid is centred BEHIND the point everything else
## calls the glove and reaches `along - back` PAST it. A ball placed a fixed
## distance from that point, in a direction with any component down the fingers,
## is therefore pierced by them however generous the distance looks.
##
## Empty when no model is installed for the role: a procedural body measures its
## own blob and has no business reading these.
static func mitt_shape(role: int) -> Dictionary:
	if _scene(role) == null or _hand_length <= 0.0 or _hand_radius <= 0.0:
		return {}
	var keeper: bool = role == ROLE_KEEPER
	var shape: Vector3 = _MITT_KEEPER if keeper else _MITT_SHOOTER
	var fraction: float = _MITT_REACH_KEEPER if keeper else _MITT_REACH_SHOOTER
	var reach: float = float(_model_metrics.get("hand_reach", _hand_length * 0.5))
	var k: float = _role_scale(role)
	return {
		"along": shape.z * _hand_length * k,
		"girth": maxf(shape.x, shape.y) * _hand_radius * k,
		"back": reach * (1.0 - fraction) * k,
	}


## The glove SOLID of a BUILT figure, in WORLD space, or an empty dictionary when
## this body has none: a procedural fallback, or a figure not yet in the tree.
##
##   "centre"   Vector3, the middle of the padded ellipsoid
##   "axis"     Vector3, unit, the direction the fingers run in
##   "across"   Vector3, unit, the width of the palm
##   "through"  Vector3, unit, the palm normal, the THIN direction
##   "along" "half_across" "half_through"   float, the three semi axes
##
## All THREE are published, and the third one is not a detail. This glove is a
## flat pad: 105 mm down the fingers, 52 mm across the palm and 19 mm through it.
## A caller that folds the last two into one radius and takes the larger seats a
## ball on the palm 33 mm off the leather, which is a visible gap and was one.
##
## `mitt_shape` says what glove a role is BUILT with. THIS says where a particular
## figure's glove has ENDED UP once it has been posed, and only the second one is
## any use to a caller trying to put a ball in it. They are different questions
## because the arms are solved by `Keeper` against `hand_reach` while the glove is
## drawn by `_add_mitts` around a point of its own, and because `pose()` bounds how
## far an over extended arm may follow its target at all.
static func mitt_solid(figure: Node3D, left: bool) -> Dictionary:
	if figure == null:
		return {}
	var node := figure.find_child("MittMesh%s" % ("L" if left else "R"), true, false) as MeshInstance3D
	if node == null or not node.is_inside_tree():
		return {}
	var box: AABB = node.get_aabb()
	if box.size.x < 0.0001 or box.size.y < 0.0001 or box.size.z < 0.0001:
		return {}
	# The semi axes come off the BASIS and not off the AABB. `_add_mitts` builds a
	# SphereMesh sized ACROSS the palm and stretches its z into the length of the
	# fingers through the transform, so the box alone reports a round glove and the
	# figure's own scale is not in it either.
	var xform: Transform3D = node.global_transform
	var half: Vector3 = box.size * 0.5
	var along: Vector3 = xform.basis.z * half.z
	var across: Vector3 = xform.basis.x * half.x
	var through: Vector3 = xform.basis.y * half.y
	if along.length_squared() < 0.000001 or across.length_squared() < 0.000001 \
			or through.length_squared() < 0.000001:
		return {}
	return {
		"centre": xform * box.get_center(),
		"axis": along.normalized(),
		"across": across.normalized(),
		"through": through.normalized(),
		"along": along.length(),
		"half_across": across.length(),
		"half_through": through.length(),
	}


## Poses a figure built by `build()` from world space joint positions.
##
## Every key is optional: a joint that is not supplied simply keeps the rotation
## it inherits from its parent, which is why a caller can drive the arms without
## caring that the model also owns 151 finger, toe and face bones.
##
## Bases are FACING bases: +Y is up and +Z is the direction the figure looks.
## That is the frame `Keeper` already works in; a caller whose body faces -Z (the
## Godot node convention, and the shooter's case) turns its basis half a circle
## about its own Y before handing it over.
##
##   "hips"    Vector3, world position of the hip midpoint. Placement anchor.
##   "body"    Basis, the pelvis facing basis.
##   "chest"   Basis, the chest facing basis. The bend between "body" and
##             "chest" is spread over the four spine joints rather than snapped
##             into one, so a keeper folded over a low block still has a spine.
##   "head"    Basis, the head facing basis, likewise spread over the neck.
##   "shoulder_l" "elbow_l" "wrist_l" "glove_l"   Vector3, and the same in _r.
##   "hip_l" "knee_l" "ankle_l" "toe_l"           Vector3, and the same in _r.
##
## Every limb bone is PINNED: it takes both the direction of the segment AND the
## world position of the joint the caller solved. That is deliberate and it is
## the thing that keeps the module honest.
##
## Aiming a bone by direction alone and letting forward kinematics decide where
## it lands looks tidier, and it was measured to be wrong: a keeper at full
## stretch has his gloves further from his shoulders than his arms are long, the
## solver above reports that (it stretches a limb up to 30 percent, exactly as
## the procedural body always did by scaling its meshes), and a rest length rig
## simply cannot follow. The gloves came out up to 13 cm short of the gloves the
## save test uses, which is most of a glove radius, and it is the one lie this
## module must not tell. Pinning makes the figure reproduce the solve to the
## millimetre and pays for it in a little skin stretch at full extension only.
##
## The caller still has to solve with the lengths `metrics()` reports, or the
## stretch is present in every pose instead of only at the limit.
static func pose(figure: Node3D, joints: Dictionary) -> void:
	if figure == null or not figure.is_inside_tree():
		return
	var skeleton: Skeleton3D = figure.get_meta(&"skeleton", null) as Skeleton3D
	if skeleton == null or not is_instance_valid(skeleton):
		return

	var body := _basis_of(joints, "body", Basis.IDENTITY)
	var k := float(figure.get_meta(&"scale", 1.0))
	var anchor: Vector3 = figure.get_meta(&"anchor", Vector3.ZERO)
	var hips := _vec_of(joints, "hips", figure.global_position)
	# The rig node carries the placement, so the root bone never leaves its rest
	# and the mesh stays inside the cull box wherever the keeper ends up.
	figure.global_transform = Transform3D(
		body * Basis.from_scale(Vector3(k, k, k)), hips - body * (anchor * k))

	var to_figure := skeleton.global_transform.affine_inverse()
	var to_local := to_figure.basis
	_bend(skeleton, to_local, BONE_SPINE, body, _basis_of(joints, "chest", body))
	_bend(skeleton, to_local, BONE_NECK,
		_basis_of(joints, "chest", body), _basis_of(joints, "head", body))
	var head_index := skeleton.find_bone("head")
	if head_index >= 0:
		# BOTH figures, not just the keeper. See `HEAD_SCALE`.
		#
		# The lift comes FIRST in the reading even though it is written second: the
		# pair is one operation, "scale the skull about its own floor", and the two
		# halves are only separate because Godot scales a bone about its origin and
		# offers no pivot. The order of the two calls does not matter, but both must
		# come after `_bend`, which writes a whole global pose and would drop them.
		skeleton.set_bone_pose_scale(head_index, Vector3.ONE * HEAD_SCALE)
		if _head_rise > 0.0:
			# In the bone's own frame, so the skull rises ALONG THE NECK rather than
			# along world up: a keeper folded sideways over a low block must not have
			# his head slide out of his collar.
			skeleton.set_bone_pose_position(head_index,
				skeleton.get_bone_rest(head_index).origin + Vector3(0.0, _head_rise, 0.0))

	# Every joint the caller solved, once, in the skeleton's OWN frame. Working
	# there and not in world space is what lets the arm relaxation below compare a
	# solved segment against a rest length without carrying the role scale around.
	var local: Dictionary = {}
	for key in _AIMS:
		var pair_keys: Array = _AIMS[key]
		for joint_key in pair_keys:
			if joints.has(joint_key) and not local.has(joint_key):
				local[joint_key] = to_figure * _vec_of(joints, joint_key, Vector3.ZERO)
	var girdle: Dictionary = _relax_arms(skeleton, local)
	_unlock_elbows(local)

	for bone_name in _AIM_ORDER:
		var pair: Array = _AIMS[bone_name]
		var from_key: String = pair[0]
		var to_key: String = pair[1]
		if not local.has(from_key) or not local.has(to_key):
			continue
		var from_point: Vector3 = local[from_key]
		var to_point: Vector3 = local[to_key]
		var delta := to_point - from_point
		if delta.length_squared() < 0.000001:
			continue
		var target := delta.normalized()
		var rest_dir := _rest_dir(skeleton, bone_name)
		if rest_dir == Vector3.ZERO:
			continue
		var index := skeleton.find_bone(bone_name)
		if index < 0:
			continue
		var swing := _swing(rest_dir, target)
		# The shoulder or the hip takes its share of the turn first, so the
		# deltoid and the glute travel with the limb instead of creasing. On an arm
		# that had to be relaxed it also carries most of the girdle slide, so the
		# shoulder TRAVELS towards the hand the way a real one does rather than the
		# chest simply losing its arm.
		var shared: String = _SHARED_WITH.get(bone_name, "")
		if not shared.is_empty():
			var helper := skeleton.find_bone(shared)
			if helper >= 0:
				var inherited := skeleton.get_bone_global_pose(helper).basis.orthonormalized()
				_set_global_basis(skeleton, helper,
					Basis(Quaternion(inherited).slerp(Quaternion(swing), _SHARE)),
					girdle.get(shared, Vector3.ZERO) * _GIRDLE_CLAVICLE)
		# Then the bone is PINNED onto the joint the caller solved. See the note
		# on pinning above `pose()`.
		skeleton.set_bone_global_pose(index, Transform3D(swing, from_point))


static func clear_cache() -> void:
	_scene_cache.clear()
	_model_metrics.clear()
	_rest_dirs.clear()
	_rest_spans.clear()
	_kit_mesh = null
	_shaped_mesh = null
	_hair_cap = null
	_limbs.clear()
	_arm_root = Vector3.ZERO
	_arm_dir = Vector3.ZERO
	_arm_span = 0.0
	_head_rise = 0.0
	_skull_floor = 0.0
	_head_binds.clear()
	_hand_axis = Vector3.ZERO
	_hand_normal = Vector3.ZERO
	_hand_length = 0.0
	_hand_radius = 0.0
	_probed = false


# --- loading ------------------------------------------------------------------


static func _scene(role: int) -> PackedScene:
	if role != ROLE_KEEPER and role != ROLE_SHOOTER:
		return null
	if _probed:
		return _scene_cache.get("player", null) as PackedScene
	_probed = true
	var found: PackedScene = null
	var path := "%s/%s" % [MODEL_DIR, PLAYER_FILE]
	if ResourceLoader.exists(path):
		found = load(path) as PackedScene
		if found == null:
			push_warning("CharacterModels: %s exists but did not load as a scene." % path)
	_scene_cache["player"] = found
	if found != null:
		_measure(found)
	return found


static func _role_scale(role: int) -> float:
	var height := float(_model_metrics.get("height", 0.0))
	if height <= 0.01:
		return 1.0
	var wanted := SHOOTER_HEIGHT if role == ROLE_SHOOTER else KEEPER_HEIGHT
	return wanted / height


## Measures the model once, in its own units, from a throwaway instance.
##
## Nothing here is taken from a table: the joint positions come from the rest
## skeleton and the hand and boot centres from the vertices of their own
## surfaces. A model that was re-exported at another height, or with a longer
## forearm, therefore keeps driving the inverse kinematics correctly instead of
## quietly putting the gloves 10 cm past the ball.
static func _measure(scene: PackedScene) -> void:
	_model_metrics.clear()
	var probe := scene.instantiate()
	if probe == null:
		return
	var skeleton := _find_skeleton(probe)
	var mesh_instance := _find_mesh(probe)
	if skeleton == null or mesh_instance == null or mesh_instance.mesh == null:
		push_warning("CharacterModels: the model has no skeleton or no mesh, ignoring it.")
		probe.free()
		return

	# The shaping is resolved BEFORE anything is measured, and the three vertex
	# measurements below go through it, so the metrics describe the body that is
	# actually going to be drawn rather than the one the file shipped.
	_build_shape_frame(skeleton)

	var hip_l := _rest_point(skeleton, "upperleg01.L")
	var hip_r := _rest_point(skeleton, "upperleg01.R")
	var anchor := (hip_l + hip_r) * 0.5
	var shoulder := _rest_point(skeleton, "upperarm01.L")
	var box: AABB = mesh_instance.mesh.get_aabb()

	var wrist := _rest_point(skeleton, "wrist.L")
	var ankle := _rest_point(skeleton, "foot.L")
	var hand_centre := _surface_centre(mesh_instance.mesh, SURFACE_HANDS)
	var boot_centre := _surface_centre(mesh_instance.mesh, SURFACE_BOOTS)

	_model_metrics = {
		"height": maxf(box.end.y, 0.01),
		"hip_height": anchor.y,
		"shoulder_half": absf(shoulder.x),
		"shoulder_rise": shoulder.y - anchor.y,
		"hip_half": absf(hip_l.x),
		"torso": _rest_point(skeleton, "neck01").y - anchor.y,
		"head_lift": _rest_point(skeleton, "head").y - _rest_point(skeleton, "neck01").y,
		"upper_arm": _rest_span(skeleton, "upperarm01.L", "lowerarm01.L"),
		"fore_arm": _rest_span(skeleton, "lowerarm01.L", "wrist.L"),
		"thigh": _rest_span(skeleton, "upperleg01.L", "lowerleg01.L"),
		"shin": _rest_span(skeleton, "lowerleg01.L", "foot.L"),
		# The hand and boot surfaces each hold a mirrored pair symmetric about
		# x = 0, so the centre of the +X half is the LEFT hand and LEFT boot.
		"hand_reach": maxf(wrist.distance_to(hand_centre), 0.02),
		"foot_reach": maxf(ankle.distance_to(boot_centre), 0.02),
		# How far the sole hangs under the ankle. A rig that guesses this instead
		# of measuring it stands its player either in the turf or above it.
		"sole_drop": maxf(ankle.y - _surface_low(mesh_instance.mesh, SURFACE_BOOTS), 0.01),
		"anchor": anchor,
	}
	_measure_head(mesh_instance, skeleton)
	_measure_hand(mesh_instance.mesh, skeleton)
	probe.free()


## How far the head bone has to rise before `HEAD_SCALE` is applied to it, so that
## the enlarged skull grows upwards out of the collar instead of downwards into it.
## See the block above `_NECK_SHOW` for the failure this repairs.
static func _measure_head(mesh_instance: MeshInstance3D, skeleton: Skeleton3D) -> void:
	_head_rise = 0.0
	_skull_floor = 0.0
	_head_binds.clear()
	var head := skeleton.find_bone("head")
	if head < 0 or mesh_instance.mesh == null:
		return
	var head_y := skeleton.get_bone_global_rest(head).origin.y
	var floor_y := _head_floor(mesh_instance, skeleton, head)
	# A measurement that came back outside the skull is a measurement that failed,
	# and lifting the head by a wrong number is worse than not lifting it: the
	# figure keeps the shipped pivot and the collar keeps the shipped clash.
	if floor_y >= head_y or floor_y < head_y - 0.30:
		push_warning("CharacterModels: the skull floor came out at %.3f for a head joint at %.3f, keeping the joint as the pivot."
			% [floor_y, head_y])
		return
	_skull_floor = floor_y
	_head_rise = (HEAD_SCALE - 1.0) * (head_y - floor_y) + _NECK_SHOW
	# Published, because a caller that puts a hand on this head has to know the
	# skull is no longer centred on the joint it measures against.
	_model_metrics["head_rise"] = _head_rise


## Lowest point of the geometry the head bone owns OUTRIGHT, in the model's own
## units. That is the jaw line, and it is the point the enlarged head is scaled
## about.
##
## Engine trap, and it is the one that makes this function longer than it looks:
## `ARRAY_BONES` indexes the SKIN's bind list, NOT the skeleton's bone order. Read
## as a bone index it silently measures somebody else's limb. A first pass of this
## code did exactly that and reported the skull floor at hip height, off the hand.
static func _head_floor(mesh_instance: MeshInstance3D, skeleton: Skeleton3D,
		head: int) -> float:
	var owned: Dictionary = {}
	var skin: Skin = mesh_instance.skin
	if skin == null:
		owned[head] = true
	else:
		for b in skin.get_bind_count():
			var bone := skin.get_bind_bone(b)
			if bone < 0:
				bone = skeleton.find_bone(skin.get_bind_name(b))
			if bone == head:
				owned[b] = true
	if owned.is_empty():
		return 1.0e9
	_head_binds = owned
	var mesh: Mesh = mesh_instance.mesh
	var low := 1.0e9
	for s in mesh.get_surface_count():
		var arrays: Array = mesh.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_WEIGHTS or arrays[Mesh.ARRAY_BONES] == null \
				or arrays[Mesh.ARRAY_WEIGHTS] == null:
			continue
		var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var bones: PackedInt32Array = arrays[Mesh.ARRAY_BONES]
		var weights: PackedFloat32Array = arrays[Mesh.ARRAY_WEIGHTS]
		if verts.is_empty():
			continue
		var influences := bones.size() / verts.size()
		for i in verts.size():
			if verts[i].y >= low:
				continue
			var w := 0.0
			for k in influences:
				if owned.has(bones[i * influences + k]):
					w += weights[i * influences + k]
			if w >= _HEAD_OWNED:
				low = verts[i].y
	return low


## The frame and the size of one hand, on the +X side, in the model's own units.
##
## `_hand_normal` is the palm normal, found by SWEEPING the plane perpendicular to
## the fingers for the direction the hand is thinnest. A hand is a flat thing, so
## that direction is unambiguous, and reading it off the mesh means the mitt lies
## the way the hand does even if the model is re-exported with another wrist twist.
static func _measure_hand(mesh: Mesh, skeleton: Skeleton3D) -> void:
	_hand_axis = Vector3.ZERO
	_hand_normal = Vector3.ZERO
	_hand_length = 0.0
	_hand_radius = 0.0
	var axis := _rest_dir(skeleton, "wrist.L")
	if axis == Vector3.ZERO:
		return
	var wrist := _rest_point(skeleton, "wrist.L")
	var points := PackedVector3Array()
	for s in mesh.get_surface_count():
		var mat := mesh.surface_get_material(s)
		if mat == null or mat.resource_name != SURFACE_HANDS:
			continue
		var arrays: Array = mesh.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_VERTEX or arrays[Mesh.ARRAY_VERTEX] == null:
			continue
		var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		for v in verts:
			if v.x > 0.0:
				points.append(_shape(v) - wrist)
	if points.size() < 32:
		return
	var low := 1.0e9
	var high := -1.0e9
	var radius := 0.0
	for p in points:
		var along := p.dot(axis)
		low = minf(low, along)
		high = maxf(high, along)
		radius = maxf(radius, (p - axis * along).length())
	# Two perpendiculars to sweep between. Any pair does, they only have to span
	# the plane.
	var side := axis.cross(Vector3.UP)
	if side.length_squared() < 0.000001:
		side = axis.cross(Vector3.RIGHT)
	side = side.normalized()
	var other := axis.cross(side).normalized()
	var best := 1.0e9
	var best_dir := side
	for step in 90:
		var angle := PI * float(step) / 90.0
		var dir := side * cos(angle) + other * sin(angle)
		var spread := 0.0
		for p in points:
			spread += absf(p.dot(dir))
		if spread < best:
			best = spread
			best_dir = dir
	_hand_axis = axis
	_hand_normal = best_dir
	_hand_length = maxf(high - low, 0.02)
	_hand_radius = maxf(radius, 0.01)


## Centroid of the +X half of one named surface, in mesh space. Both the hands
## and the boots are one surface holding a mirrored pair, so taking the half is
## what turns a centroid at x = 0 into a usable limb centre.
static func _surface_centre(mesh: Mesh, surface_name: String) -> Vector3:
	for s in mesh.get_surface_count():
		var mat := mesh.surface_get_material(s)
		if mat == null or mat.resource_name != surface_name:
			continue
		var arrays: Array = mesh.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_VERTEX:
			continue
		var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var sum := Vector3.ZERO
		var count := 0
		for v in verts:
			if v.x <= 0.0:
				continue
			# Through the shaping, because the hand and the boot this measures are
			# the SHAPED ones by the time anything is posed against them.
			sum += _shape(v)
			count += 1
		if count == 0:
			return Vector3.ZERO
		return sum / float(count)
	return Vector3.ZERO


## Lowest y of one named surface, in mesh space. Needs no shaping pass of its own:
## `_shape` never moves a vertex in Y, which is precisely the invariant that keeps
## the reshaped figure standing ON the turf instead of in it.
static func _surface_low(mesh: Mesh, surface_name: String) -> float:
	for s in mesh.get_surface_count():
		var mat := mesh.surface_get_material(s)
		if mat == null or mat.resource_name != surface_name:
			continue
		var arrays: Array = mesh.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_VERTEX:
			continue
		var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var low := 1.0e9
		for v in verts:
			low = minf(low, v.y)
		if low < 1.0e8:
			return low
	return 0.0


static func _rest_point(skeleton: Skeleton3D, bone_name: String) -> Vector3:
	var index := skeleton.find_bone(bone_name)
	if index < 0:
		push_warning("CharacterModels: bone '%s' is missing from the rig." % bone_name)
		return Vector3.ZERO
	return skeleton.get_bone_global_rest(index).origin


static func _rest_span(skeleton: Skeleton3D, from_bone: String, to_bone: String) -> float:
	return maxf(_rest_point(skeleton, from_bone).distance_to(_rest_point(skeleton, to_bone)), 0.01)


## The same span, cached. `_relax_arms` asks for four of them on every posed
## frame of every figure, and a rest skeleton does not change between frames.
static func _span(skeleton: Skeleton3D, from_bone: String, to_bone: String) -> float:
	var key := from_bone + ">" + to_bone
	if _rest_spans.has(key):
		return _rest_spans[key]
	var out := _rest_span(skeleton, from_bone, to_bone)
	_rest_spans[key] = out
	return out


# --- posing -------------------------------------------------------------------


## Rest direction of a segment, cached. The rig has identity rest rotations, so a
## bone's global basis is exactly the rotation carrying this vector onto the
## direction the caller wants: no per bone correction anywhere.
static func _rest_dir(skeleton: Skeleton3D, bone_name: String) -> Vector3:
	if _rest_dirs.has(bone_name):
		return _rest_dirs[bone_name]
	var out := Vector3.ZERO
	var tip: String = _SEGMENTS.get(bone_name, "")
	var index := skeleton.find_bone(bone_name)
	var tip_index := skeleton.find_bone(tip) if not tip.is_empty() else -1
	if index >= 0 and tip_index >= 0:
		var delta := skeleton.get_bone_global_rest(tip_index).origin \
			- skeleton.get_bone_global_rest(index).origin
		if delta.length_squared() > 0.000001:
			out = delta.normalized()
	if out == Vector3.ZERO:
		push_warning("CharacterModels: segment '%s' has no measurable rest direction." % bone_name)
	_rest_dirs[bone_name] = out
	return out


## Spreads the rotation from `from_basis` to `to_basis` over a chain of joints,
## the last one landing on `to_basis` exactly. A single joint carrying the whole
## bend gives a body hinged at one vertebra, which is precisely what a keeper
## doubled over a low block must not look like.
static func _bend(skeleton: Skeleton3D, to_local: Basis, chain: PackedStringArray,
		from_basis: Basis, to_basis: Basis) -> void:
	if chain.is_empty():
		return
	var a := Quaternion((to_local * from_basis).orthonormalized())
	var b := Quaternion((to_local * to_basis).orthonormalized())
	var steps := float(chain.size())
	for i in chain.size():
		var index := skeleton.find_bone(chain[i])
		if index < 0:
			continue
		var w := float(i + 1) / steps
		_set_global_basis(skeleton, index, Basis(a.slerp(b, w)))


## Sets one bone's global basis while leaving its position to forward kinematics.
##
## The origin is rebuilt from the parent's CURRENT global pose and the bone's own
## rest offset, so the bone keeps its rest length. Writing a position here
## instead would stretch the skin, and a stretched skin on a 31 k triangle body
## is visible from the far end of the stadium. `slide` is the one exception, and
## it is deliberate: `_relax_arms` uses it to walk a clavicle a few centimetres
## towards the hand, which is what a shoulder girdle actually does at full stretch.
static func _set_global_basis(skeleton: Skeleton3D, index: int, basis: Basis,
		slide: Vector3 = Vector3.ZERO) -> void:
	if index < 0:
		return
	var origin: Vector3 = skeleton.get_bone_rest(index).origin
	var parent := skeleton.get_bone_parent(index)
	if parent >= 0:
		origin = skeleton.get_bone_global_pose(parent) * origin
	skeleton.set_bone_global_pose(index, Transform3D(basis, origin + slide))


## Takes the rubber out of the arms, in the skeleton's own frame, and reports how
## far each shoulder girdle had to travel to pay for it.
##
## `local` carries the joints the caller solved and is EDITED IN PLACE: the
## shoulder, the elbow, the wrist and the glove of an over extended arm all move.
## The returned dictionary is keyed by CLAVICLE bone name, so the aim loop can
## carry the deltoid along with the arm root it just moved.
##
## The order the three payments are made in is the whole design, and it is the
## order a body uses:
##
##  1. the segments are capped at `_ARM_STRETCH_MAX`. Twelve percent of skin
##     stretch over a shoulder, an elbow and a sleeve is invisible; the thirty
##     percent `Keeper.MAX_STRETCH` allows is a rubber arm with a hand on the end.
##  2. the girdle slides up to `_GIRDLE_GIVE` along the line to the glove, which
##     buys back most of what step 1 gave up, out of real anatomy.
##  3. whatever is still missing is simply not reached, and the keeper is drawn
##     short of the ball. See `_ARM_STRETCH_MAX` for why that is the right answer.
##
## Nothing here can change a save: the pose `KeeperBrain.try_save` is measured
## against is the brain's own, and it never sees this skeleton.
static func _relax_arms(skeleton: Skeleton3D, local: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for side in ["l", "r"]:
		var upper_bone := "upperarm01.%s" % side.to_upper()
		var fore_bone := "lowerarm01.%s" % side.to_upper()
		var wrist_bone := "wrist.%s" % side.to_upper()
		var shoulder_key := "shoulder_%s" % side
		var elbow_key := "elbow_%s" % side
		var wrist_key := "wrist_%s" % side
		var glove_key := "glove_%s" % side
		if not (local.has(shoulder_key) and local.has(elbow_key) and local.has(wrist_key)):
			continue
		var shoulder: Vector3 = local[shoulder_key]
		var elbow: Vector3 = local[elbow_key]
		var wrist: Vector3 = local[wrist_key]
		var rest_upper := _span(skeleton, upper_bone, fore_bone)
		var rest_fore := _span(skeleton, fore_bone, wrist_bone)
		var upper_arm := elbow - shoulder
		var fore_arm := wrist - elbow
		var d_upper := upper_arm.length()
		var d_fore := fore_arm.length()
		var max_upper := rest_upper * _ARM_STRETCH_MAX
		var max_fore := rest_fore * _ARM_STRETCH_MAX
		var over := maxf(d_upper - max_upper, 0.0) + maxf(d_fore - max_fore, 0.0)
		if over <= 0.0001:
			continue
		# 2. The girdle pays first, along the line the arm is actually reaching on.
		var slide := Vector3.ZERO
		var glove: Vector3 = local.get(glove_key, wrist)
		var reach := glove - shoulder
		if reach.length_squared() > 0.000001:
			slide = reach.normalized() * minf(over, _GIRDLE_GIVE)
		var new_shoulder := shoulder + slide
		# 1. Then the chain is rebuilt from the new root along the caller's own
		#    directions, so the arm points exactly where it pointed and only stops
		#    short. Bending it somewhere else instead would be the renderer
		#    inventing a dive the brain never chose.
		var new_elbow := new_shoulder + upper_arm.normalized() * minf(d_upper, max_upper)
		var new_wrist := new_elbow
		if d_fore > 0.000001:
			new_wrist = new_elbow + fore_arm.normalized() * minf(d_fore, max_fore)
		local[shoulder_key] = new_shoulder
		local[elbow_key] = new_elbow
		local[wrist_key] = new_wrist
		# The hand is never stretched: it is one rigid bone plus fingers riding
		# forward kinematics. It only follows the wrist it hangs off.
		if local.has(glove_key):
			local[glove_key] = new_wrist + (glove - wrist)
		var clavicle: String = _SHARED_WITH.get(upper_bone, "")
		if not clavicle.is_empty():
			out[clavicle] = slide
	return out


## Puts a few degrees back into an elbow the caller solved perfectly straight.
##
## Measured on the running game: the elbow angle reaches exactly 180.0 degrees on
## many frames of a full stretch dive, and a limb at 180 degrees is not an arm, it
## is a tube. Both solvers can produce it honestly, because the closed form two
## link solution at maximum reach IS a straight line.
##
## The correction is almost free, and that is the point. Keeping the two segment
## lengths and opening the elbow to `_ELBOW_MIN_BEND` shortens the shoulder to
## wrist span by `a + b - sqrt(a^2 + b^2 + 2ab cos B)`, which for seven degrees on
## a half metre arm is NINE TENTHS OF A MILLIMETRE. The glove is moved by the same
## amount and no more, so the reach the difficulty is tuned against is untouched:
## it is nine hundred microns against a glove radius of sixteen centimetres.
##
## The bend is taken in the plane the caller's own elbow was already in, so the
## dive the brain chose is the dive that gets drawn. Only when the caller gives a
## dead straight chain with no plane at all does this pick one, and it picks
## BACKWARDS, which is the way an elbow goes.
static func _unlock_elbows(local: Dictionary) -> void:
	for side in ["l", "r"]:
		var shoulder_key := "shoulder_%s" % side
		var elbow_key := "elbow_%s" % side
		var wrist_key := "wrist_%s" % side
		if not (local.has(shoulder_key) and local.has(elbow_key) and local.has(wrist_key)):
			continue
		var shoulder: Vector3 = local[shoulder_key]
		var elbow: Vector3 = local[elbow_key]
		var wrist: Vector3 = local[wrist_key]
		var upper := elbow - shoulder
		var fore := wrist - elbow
		var a := upper.length()
		var b := fore.length()
		if a < 0.001 or b < 0.001:
			continue
		var span := wrist - shoulder
		var d := span.length()
		if d < 0.001:
			continue
		var straight := clampf((a * a + b * b - d * d) / (2.0 * a * b), -1.0, 1.0)
		# Zero when the arm is a straight line, positive as the elbow folds.
		if PI - acos(straight) >= _ELBOW_MIN_BEND:
			continue
		var axis := span / d
		var out := upper - axis * upper.dot(axis)
		if out.length_squared() < 1.0e-8:
			# The figure faces +Z in the skeleton's own frame, and an elbow points
			# the other way from the hand, so an elbow with no opinion goes to -Z.
			# Written out rather than as Vector3.BACK, which is +Z.
			var behind := Vector3(0.0, 0.0, -1.0)
			out = behind - axis * axis.dot(behind)
			if out.length_squared() < 1.0e-8:
				out = Vector3.DOWN - axis * axis.dot(Vector3.DOWN)
			if out.length_squared() < 1.0e-8:
				continue
		out = out.normalized()
		var opened := sqrt(maxf(a * a + b * b + 2.0 * a * b * cos(_ELBOW_MIN_BEND), 0.000001))
		var lean := asin(clampf(b * sin(_ELBOW_MIN_BEND) / opened, -1.0, 1.0))
		var new_wrist := shoulder + axis * opened
		local[elbow_key] = shoulder + (axis * cos(lean) + out * sin(lean)) * a
		local[wrist_key] = new_wrist
		var glove_key := "glove_%s" % side
		if local.has(glove_key):
			var glove: Vector3 = local[glove_key]
			local[glove_key] = glove + (new_wrist - wrist)


## Shortest rotation carrying the unit vector `from_dir` onto `to_dir`.
static func _swing(from_dir: Vector3, to_dir: Vector3) -> Basis:
	var d := clampf(from_dir.dot(to_dir), -1.0, 1.0)
	if d > 0.999999:
		return Basis.IDENTITY
	var axis := from_dir.cross(to_dir)
	if axis.length_squared() < 0.000000001:
		# Exactly opposed: any perpendicular axis is a correct half turn.
		axis = from_dir.cross(Vector3.UP)
		if axis.length_squared() < 0.000000001:
			axis = from_dir.cross(Vector3.RIGHT)
		if axis.length_squared() < 0.000000001:
			return Basis.IDENTITY
	return Basis(axis.normalized(), acos(d))


# --- burly shaping ------------------------------------------------------------


## The imported mesh with the shaping baked in, built once and shared by both
## figures. Returns the source untouched when there is nothing to work with,
## which keeps this whole block optional exactly like the model itself.
static func _shaped_body(source: Mesh, skeleton: Skeleton3D) -> ArrayMesh:
	if _shaped_mesh != null:
		return _shaped_mesh
	if source == null or skeleton == null:
		return null
	_build_shape_frame(skeleton)
	if _limbs.is_empty():
		return null
	var out := ArrayMesh.new()
	out.resource_name = "player_shaped"
	for s in source.get_surface_count():
		var arrays: Array = source.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_VERTEX or arrays[Mesh.ARRAY_VERTEX] == null:
			return null
		_shape_arrays(arrays)
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, _surface_flags(arrays))
		out.surface_set_material(out.get_surface_count() - 1, source.surface_get_material(s))
	_shaped_mesh = out
	return _shaped_mesh


## Resolves `_LIMB_PLAN` and the arm fade axis against the rest skeleton. Every
## number the shaping uses comes from the rig, so a re-exported model with a
## longer forearm thickens its own forearm rather than a remembered one.
static func _build_shape_frame(skeleton: Skeleton3D) -> void:
	if not _limbs.is_empty() or skeleton == null:
		return
	var built: Array = []
	for entry in _LIMB_PLAN:
		var from_bone: String = entry[0]
		var to_bone: String = entry[1]
		if skeleton.find_bone(from_bone) < 0 or skeleton.find_bone(to_bone) < 0:
			push_warning("CharacterModels: bone '%s' or '%s' is missing, that limb keeps its shape."
				% [from_bone, to_bone])
			continue
		var a := _mirrored(_rest_point(skeleton, from_bone))
		var b := _mirrored(_rest_point(skeleton, to_bone))
		if a.distance_squared_to(b) < 0.000001:
			continue
		# Both sides, the -X one built by NEGATING the +X one rather than by reading
		# the .R bones. Two effects, both wanted: left and right are then identical
		# to the last bit (the rig's own halves differ in the sixth decimal, which
		# is the very fault the sleeve cut already had to work around), and the
		# field stays ONE smooth function of x across the whole body. Solving on
		# the +X half and reflecting the ANSWER does not: a point between the two
		# calves is pushed across x = 0 by the leg beside it, the reflection then
		# flips its sign, and the map folds the mesh through its own midline.
		# `tests/test_character_models.gd` measures that fold at 0.045 of the kit's
		# clearance, which is a body inside out rather than merely through a shirt.
		for mirror in [1.0, -1.0]:
			built.append([Vector3(a.x * mirror, a.y, a.z),
				Vector3((b.x - a.x) * mirror, b.y - a.y, b.z - a.z),
				float(entry[2]), float(entry[3]), float(entry[4]),
				maxf(float(entry[5]), 0.001)])
	if built.is_empty():
		return
	var shoulder := _mirrored(_rest_point(skeleton, "upperarm01.L"))
	# To the FINGERS and not to the wrist. The hand hangs at hip height in the bind
	# pose, 52 cm off the midline, exactly where the width profile is climbing back
	# out of the narrowed pelvis: a profile that still applies there multiplies a
	# large x by a fast changing factor, which is a shear of 0.57 across the hand
	# and the worst squash in the whole map. Measured, and now faded out.
	var tip_bone := "finger2-1.L" if skeleton.find_bone("finger2-1.L") >= 0 else "wrist.L"
	var axis := _mirrored(_rest_point(skeleton, tip_bone)) - shoulder
	if axis.length_squared() < 0.000001:
		return
	_arm_root = shoulder
	_arm_span = axis.length()
	_arm_dir = axis / _arm_span
	_limbs = built


## Where one bind pose vertex of ANY of the seven surfaces ends up. The single
## function the whole shaping is, and the reason the kit shell and the skin under
## it can never drift apart: they are the same points through the same map.
##
## Y is never touched. See the block above `_WIDTH_PROFILE` for why that matters.
static func _shape(p: Vector3) -> Vector3:
	if _limbs.is_empty():
		return p
	# Evaluated on the WHOLE body and never on one half reflected: see the note in
	# `_build_shape_frame`. Symmetry comes from the frame being symmetric, which
	# makes it exact anyway, and costs no seam down the middle of the figure.
	var fade := minf(_torso_weight(p, 1.0), _torso_weight(p, -1.0))
	var width := 1.0 + (_profile(_WIDTH_PROFILE, p.y) - 1.0) * fade
	var depth := 1.0 + (_profile(_DEPTH_PROFILE, p.y) - 1.0) * fade
	var push := _limb_push(p)
	return Vector3(
		(p.x + push.x) * width,
		p.y,
		_DEPTH_CENTRE + (p.z + push.z - _DEPTH_CENTRE) * depth)


## Multiplier read off a profile curve at one height, smoothstepped between knots.
static func _profile(curve: PackedVector2Array, y: float) -> float:
	var count := curve.size()
	if count == 0:
		return 1.0
	if y <= curve[0].x:
		return curve[0].y
	for i in range(1, count):
		if y > curve[i].x:
			continue
		var a := curve[i - 1]
		var b := curve[i]
		if b.x - a.x <= 0.000001:
			return b.y
		return lerpf(a.y, b.y, smoothstep(a.x, b.x, y))
	return curve[count - 1].y


## How much of the torso profile applies here, for the arm on one side. One on the
## torso and on the deltoid, zero from the elbow outwards. See `_ARM_FADE_NEAR`.
static func _torso_weight(p: Vector3, side: float) -> float:
	if _arm_span <= 0.0:
		return 1.0
	var root := Vector3(_arm_root.x * side, _arm_root.y, _arm_root.z)
	var dir := Vector3(_arm_dir.x * side, _arm_dir.y, _arm_dir.z)
	var along := clampf((p - root).dot(dir) / _arm_span, 0.0, 1.0)
	var off_axis := p.distance_to(root + dir * (along * _arm_span))
	var on_arm := 1.0 - smoothstep(_ARM_FADE_NEAR, _ARM_FADE_FAR, off_axis)
	return 1.0 - on_arm * smoothstep(_ARM_FADE_FROM, _ARM_FADE_TO, along)


## Radial thickening of the limbs, summed over every segment that reaches here.
##
## The push is taken in the XZ PLANE and never along Y, which is the invariant the
## whole pass rests on. A thigh is upright, so for a leg that is the true radial
## direction; an arm hangs at 46 degrees, so its section comes out very slightly
## elliptical, which on a stylised body with a doubled head nobody will ever see
## and which buys an invariant worth far more.
static func _limb_push(p: Vector3) -> Vector3:
	var out := Vector3.ZERO
	for limb in _limbs:
		var origin: Vector3 = limb[0]
		var span: Vector3 = limb[1]
		var t := clampf((p - origin).dot(span) / span.length_squared(), 0.0, 1.0)
		var band := _band(t, float(limb[3]), float(limb[4]))
		if band <= 0.0:
			continue
		var radial := p - (origin + span * t)
		var reduced := radial.length() / float(limb[5])
		if reduced > 4.0:
			continue
		out += Vector3(radial.x, 0.0, radial.z) \
			* (float(limb[2]) * band * exp(-reduced * reduced))
	return out


## One inside a limb's own stretch, tapering to nothing at each fenced off end.
static func _band(t: float, low: float, high: float) -> float:
	var weight := 1.0
	if low > 0.0:
		weight *= smoothstep(low, minf(low + _LIMB_TAPER, 1.0), t)
	if high < 1.0:
		weight *= 1.0 - smoothstep(maxf(high - _LIMB_TAPER, 0.0), high, t)
	return weight


## Pushes one surface's arrays through `_shape`, positions, normals and tangents.
##
## A normal is NOT carried by a deformation: its inverse transpose is. Widening a
## chest tips every normal lying on it, and a normal left alone lights the new
## shape with the old shape's shading, which on a body with a rim lit outline is
## a figure that looks subtly inflated rather than built. The Jacobian is taken by
## finite difference off the very same `_shape`, so it cannot drift away from the
## geometry the way a hand derived one would.
static func _shape_arrays(arrays: Array) -> void:
	var vertex: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	if vertex.is_empty():
		return
	var normal := PackedVector3Array()
	if arrays[Mesh.ARRAY_NORMAL] != null:
		normal = arrays[Mesh.ARRAY_NORMAL]
	var tangent := PackedFloat32Array()
	if arrays[Mesh.ARRAY_TANGENT] != null:
		tangent = arrays[Mesh.ARRAY_TANGENT]
	var has_normal := normal.size() == vertex.size()
	var has_tangent := tangent.size() == vertex.size() * 4
	for i in vertex.size():
		var p := vertex[i]
		var moved := _shape(p)
		vertex[i] = moved
		if not has_normal and not has_tangent:
			continue
		var jacobian := Basis(
			(_shape(p + Vector3(_JACOBIAN_STEP, 0.0, 0.0)) - moved) / _JACOBIAN_STEP,
			(_shape(p + Vector3(0.0, _JACOBIAN_STEP, 0.0)) - moved) / _JACOBIAN_STEP,
			(_shape(p + Vector3(0.0, 0.0, _JACOBIAN_STEP)) - moved) / _JACOBIAN_STEP)
		if absf(jacobian.determinant()) < 0.000001:
			continue
		if has_normal:
			var n := jacobian.inverse().transposed() * normal[i]
			if n.length_squared() > 0.000000001:
				normal[i] = n.normalized()
		if has_tangent:
			var t := jacobian * Vector3(tangent[i * 4], tangent[i * 4 + 1], tangent[i * 4 + 2])
			if t.length_squared() > 0.000000001:
				t = t.normalized()
				tangent[i * 4] = t.x
				tangent[i * 4 + 1] = t.y
				tangent[i * 4 + 2] = t.z
	arrays[Mesh.ARRAY_VERTEX] = vertex
	if has_normal:
		arrays[Mesh.ARRAY_NORMAL] = normal
	if has_tangent:
		arrays[Mesh.ARRAY_TANGENT] = tangent


# --- kit seams ----------------------------------------------------------------


## One pool of loose triangle vertices, with every attribute the source mesh
## carries, so a surface can be pushed through it and the pieces re-labelled.
##
## Not a `SurfaceTool`: the cut has to interpolate the bone influences of every
## new vertex and hand back the exact index it created, and `SurfaceTool` offers
## neither.
class _KitSoup extends RefCounted:
	var vertex := PackedVector3Array()
	var normal := PackedVector3Array()
	var tangent := PackedFloat32Array()
	var uv := PackedVector2Array()
	var bones := PackedInt32Array()
	var weights := PackedFloat32Array()
	## Bone influences per vertex, read off the arrays rather than assumed.
	var influences := 0

	## Pours one surface into the pool and appends its triangles, re-indexed.
	func absorb(arrays: Array, tris: Array[int]) -> void:
		var base := vertex.size()
		var v: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		vertex.append_array(v)
		if arrays[Mesh.ARRAY_NORMAL] != null:
			normal.append_array(arrays[Mesh.ARRAY_NORMAL])
		if arrays[Mesh.ARRAY_TANGENT] != null:
			tangent.append_array(arrays[Mesh.ARRAY_TANGENT])
		if arrays[Mesh.ARRAY_TEX_UV] != null:
			uv.append_array(arrays[Mesh.ARRAY_TEX_UV])
		if arrays[Mesh.ARRAY_BONES] != null and arrays[Mesh.ARRAY_WEIGHTS] != null:
			var b: PackedInt32Array = arrays[Mesh.ARRAY_BONES]
			influences = b.size() / maxi(v.size(), 1)
			bones.append_array(b)
			weights.append_array(arrays[Mesh.ARRAY_WEIGHTS])
		var idx: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		for i in idx:
			tris.append(base + i)

	## Adds the vertex at parameter `t` along the segment `a` -> `b`, whose
	## position the caller already computed in a canonical order so that the two
	## triangles sharing the edge land on the very same point. Returns its index.
	func split_edge(a: int, b: int, t: float, point: Vector3) -> int:
		var out := vertex.size()
		vertex.append(point)
		if normal.size() > 0:
			var n := normal[a].lerp(normal[b], t)
			normal.append(n.normalized() if n.length_squared() > 1.0e-12 else normal[a])
		if tangent.size() > 0:
			var ta := Vector3(tangent[a * 4], tangent[a * 4 + 1], tangent[a * 4 + 2])
			var tb := Vector3(tangent[b * 4], tangent[b * 4 + 1], tangent[b * 4 + 2])
			var td := ta.lerp(tb, t)
			td = td.normalized() if td.length_squared() > 1.0e-12 else ta
			var handedness := tangent[a * 4 + 3]
			tangent.append(td.x)
			tangent.append(td.y)
			tangent.append(td.z)
			tangent.append(handedness)
		if uv.size() > 0:
			uv.append(uv[a].lerp(uv[b], t))
		if influences > 0:
			_blend_skin(a, b, t)
		return out

	## Blends two skin bindings. The union of the two bone lists is weighted,
	## sorted, truncated back to `influences` and renormalised: a vertex that kept
	## some of its influences without renormalising is a vertex that drifts
	## towards the origin the moment the body leaves the bind pose.
	func _blend_skin(a: int, b: int, t: float) -> void:
		var mixed: Dictionary = {}
		for k in influences:
			var wa := weights[a * influences + k] * (1.0 - t)
			if wa > 0.0:
				var ba := bones[a * influences + k]
				mixed[ba] = float(mixed.get(ba, 0.0)) + wa
			var wb := weights[b * influences + k] * t
			if wb > 0.0:
				var bb := bones[b * influences + k]
				mixed[bb] = float(mixed.get(bb, 0.0)) + wb
		var ranked: Array = []
		for bone in mixed:
			ranked.append([float(mixed[bone]), int(bone)])
		ranked.sort_custom(func(x: Array, y: Array) -> bool: return x[0] > y[0])
		var kept := mini(ranked.size(), influences)
		var total := 0.0
		for i in kept:
			total += float(ranked[i][0])
		if total <= 0.0:
			total = 1.0
		for i in influences:
			if i < kept:
				bones.append(int(ranked[i][1]))
				weights.append(float(ranked[i][0]) / total)
			else:
				bones.append(0)
				weights.append(0.0)


## Rebuilds the imported mesh with every garment edge cut on a clean analytic
## surface. Returns null when there is nothing to fix, which leaves the caller on
## the imported mesh untouched.
##
## THE RULE, and it is the whole point of this function: a garment edge is a
## SURFACE, and the triangles that straddle it are SPLIT ON IT rather than pushed
## whole onto one side. Assigning a whole triangle by its centroid still leaves a
## saw tooth one triangle deep, which on a 3 cm shell is a centimetre of ragged
## edge, and one of those edges is the shooter's collar, which sits in the bottom
## centre of the screen on every aiming frame.
##
## Two different faults are being repaired here, and they need saying apart.
##
## The first is the SPLIT between garments: which triangle of the torso shell is
## shirt, which is sleeve, which is shorts. The file decides that per triangle by
## testing bone weights and height, and that test disagrees from one triangle to
## the next. It put a stair step across the collar and both shoulder seams, left
## one shoulder with a sleeve and the other with none (left and right bone
## weights differ in the sixth decimal), and punched rectangular notches of
## shorts colour up into the shirt hem. Three planes replace it, and the arm pair
## is ONE plane mirrored so the two sleeves cannot disagree.
##
## The second is the OPEN EDGES the shell was authored with: the neck hole, the
## two cuffs, the two leg holes of the shorts and the two sock tops were each
## opened by deleting triangles one at a time, so all seven are ragged in the
## file itself. Deleted geometry cannot be brought back, so each opening is cut
## again just PAST its worst tooth, on a plane, or for the neck on the elliptical
## prism that is the only shape which separates a wide collar from a deep chest.
## Every threshold is measured off this mesh's own open edges at load time.
static func _recut_kit(source: Mesh, skeleton: Skeleton3D) -> ArrayMesh:
	if _kit_mesh != null:
		return _kit_mesh
	if source == null or skeleton == null:
		return null

	var soup := _KitSoup.new()
	var piece: Dictionary = {}
	# Each plan entry is either a surface copied through, or a placeholder the
	# recut fills in. Emitting in the source order keeps `surface_get_material`
	# and every name based lookup in this file reading the same mesh as before.
	var plan: Array = []
	for s in source.get_surface_count():
		var material := source.surface_get_material(s)
		var surface_name := material.resource_name if material != null else ""
		var arrays: Array = source.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_INDEX or arrays[Mesh.ARRAY_INDEX] == null:
			return null
		if _KIT.has(surface_name):
			var tris: Array[int] = []
			soup.absorb(arrays, tris)
			piece[surface_name] = tris
			plan.append({"name": surface_name, "material": material, "arrays": []})
		else:
			plan.append({"name": "", "material": material, "arrays": arrays})
	if piece.size() != _KIT.size():
		push_warning("CharacterModels: the model is missing a kit surface, keeping the imported cut.")
		return null

	# The shell is exactly three connected pieces: the torso, which has to become
	# a shirt, two sleeves and a pair of shorts, and one piece per lower leg,
	# which has to become a sock and a boot. Both splits came out of the same
	# per triangle test and both are ragged, so both are made again.
	var torso: Array[int] = []
	for garment in _POOL:
		torso.append_array(piece[garment])
	var legs: Array[int] = []
	legs.append_array(piece[SURFACE_SOCKS])
	legs.append_array(piece[SURFACE_BOOTS])
	# The boot collar. The file has sock and boot overlapping over four
	# centimetres of ankle, which is what makes the current boundary a row of
	# black steps; the middle of that overlap is where the two were meant to
	# meet.
	var boot_line := (_lowest(soup, piece[SURFACE_SOCKS])
		+ _highest(soup, piece[SURFACE_BOOTS])) * 0.5

	# Landmarks, all off the rest skeleton, so a re-exported model keeps its
	# seams where its own body puts them.
	var hip := (_rest_point(skeleton, "upperleg01.L")
		+ _rest_point(skeleton, "upperleg01.R")) * 0.5
	var neck := _rest_point(skeleton, "neck01")
	var shoulder := _mirrored(_rest_point(skeleton, "upperarm01.L"))
	var elbow := _mirrored(_rest_point(skeleton, "lowerarm01.L"))
	var wrist := _mirrored(_rest_point(skeleton, "wrist.L"))
	var arm := wrist - shoulder
	if arm.length_squared() < 1.0e-9:
		return null
	arm = arm.normalized()
	var elbow_reach := (elbow - shoulder).dot(arm)

	# Where every open edge of the shell currently sits.
	var torso_open := _open_vertices(soup, torso)
	var legs_open := _open_vertices(soup, legs)
	# Shorts: cloth is ABOVE the hole, so the cut goes at the TOP of the worst
	# tooth and everything below it goes.
	var shorts_hem := -1.0e9
	# Cuff: cloth is towards the shoulder, so the cut goes at the NEAREST tooth.
	var cuff_reach := 1.0e9
	# Collar: the hole has to be widened past every tooth, so the slab that cuts
	# it has to cover them all.
	var collar: Array[int] = []
	for i in torso_open:
		var p := soup.vertex[i]
		if p.y < hip.y - _SHORTS_BAND:
			shorts_hem = maxf(shorts_hem, p.y)
		if p.y > neck.y - _COLLAR_BAND:
			collar.append(i)
		var reach := (_mirrored(p) - shoulder).dot(arm)
		if reach > elbow_reach:
			cuff_reach = minf(cuff_reach, reach)
	# Sock: cloth is BELOW the hole, so the cut goes at the LOWEST tooth. The leg
	# shells have no other opening, the boot being closed.
	var sock_top := 1.0e9
	for i in legs_open:
		sock_top = minf(sock_top, soup.vertex[i].y)

	# 1. The shirt hem. The arms live entirely above it and the shorts entirely
	#    below it, so this one plane needs no further thought.
	var hem_y := hip.y + _HEM_RISE
	var split := _clip(soup, torso, _below(hem_y))
	var shorts: Array[int] = split[0]
	var jersey: Array[int] = split[1]

	# 2. The two sleeve rings. The arm points down and outwards at 46 degrees, so
	#    the plane perpendicular to it also sweeps across the lower chest: the far
	#    side of the ring is NOT the arm alone. What separates them is topology
	#    rather than geometry, and the exact cut is what makes the topology
	#    usable. The arm beyond the ring can only reach the chest through the
	#    shoulder, which is on the near side, so on the far side the two are two
	#    disconnected pieces. `_pick_piece` keeps the one that runs out to the
	#    wrist and hands the rest back to the shirt.
	var sleeves: Array[int] = []
	var sleeve_end := shoulder + arm * (elbow_reach * _SLEEVE_FRACTION)
	for mirror in [1.0, -1.0]:
		var origin := Vector3(sleeve_end.x * mirror, sleeve_end.y, sleeve_end.z)
		var axis := Vector3(arm.x * mirror, arm.y, arm.z)
		split = _clip(soup, jersey, _beyond(origin, axis))
		var sorted := _pick_piece(soup, split[0], origin, axis)
		sleeves.append_array(sorted[0])
		jersey = split[1]
		jersey.append_array(sorted[1])

	# 3. The collar. This one earns its shape, so here is the reasoning.
	#
	#    A cut is only clean where the cutting surface crosses the cloth at an
	#    angle. Where the two are parallel the cut curve is decided by millimetre
	#    bumps in the cloth, and this cloth has two of them right on the centre
	#    line: it is a shell offset off a real anatomy, so it carries the hollow
	#    of the suprasternal notch at the front and the knuckle of the seventh
	#    vertebra at the back. Any round cutter (a sphere, a cylinder, an ellipse
	#    upright around the neck) is parallel to the chest exactly there, and it
	#    bites a V out of the front of the collar and a tab out of the back. That
	#    was measured, by cutting with an ellipse and looking at the render.
	#
	#    What the cloth does around the neck decides the answer: sideways over
	#    the trapezius it is nearly HORIZONTAL, so it wants a vertical cutter,
	#    and forwards down the sternum it is nearly VERTICAL, so it wants a
	#    horizontal one. The shape that is both is a slab: two upright planes at
	#    +/- half_x and a floor, with the two corners rounded off. It crosses the
	#    cloth at a healthy angle the whole way round.
	#
	#    The slab is then GROWN until it swallows every tooth of the ragged neck
	#    hole the file shipped, because a tooth left behind is the whole defect.
	if collar.size() >= 3:
		var half_x := 0.0
		var floor_y := 1.0e9
		for i in collar:
			half_x = maxf(half_x, absf(soup.vertex[i].x))
			floor_y = minf(floor_y, soup.vertex[i].y)
		half_x += _COLLAR_MARGIN
		floor_y -= _COLLAR_MARGIN
		var field := _inside_collar(half_x, floor_y, _COLLAR_ROUND)
		for _attempt in _COLLAR_TRIES:
			var covered := true
			for i in collar:
				if float(field.call(soup.vertex[i])) <= 0.0:
					covered = false
					break
			if covered:
				break
			half_x += _COLLAR_MARGIN
			floor_y -= _COLLAR_MARGIN
			field = _inside_collar(half_x, floor_y, _COLLAR_ROUND)
		#    EVERYTHING inside the slab goes, with no piece handed back. The slab is
		#    a narrow vertical SLOT, about as wide as the neck and far narrower than
		#    the shoulders, so what it encloses is the collar and nothing else, and
		#    the two halves of the shirt stay joined over the shoulders, which are
		#    outside the slot. Sorting the offcut into pieces and keeping one, the
		#    way the sleeve ring has to, can only ever leave a flap of shirt standing
		#    loose beside the neck here.
		split = _clip(soup, jersey, field)
		jersey = split[1]
		if split[0].is_empty():
			push_warning("CharacterModels: the collar slab cut nothing, the neck hole keeps its teeth.")

	# 4, 5, 6. The three remaining openings, each cut just past its worst tooth.
	if shorts_hem > -1.0e8:
		shorts = _clip(soup, shorts, _below(shorts_hem))[1]
	if cuff_reach < 1.0e8:
		for mirror in [1.0, -1.0]:
			var origin := shoulder + arm * cuff_reach
			origin.x *= mirror
			var axis := Vector3(arm.x * mirror, arm.y, arm.z)
			sleeves = _clip(soup, sleeves, _beyond(origin, axis))[1]
	split = _clip(soup, legs, _below(boot_line))
	var boots: Array[int] = split[0]
	var socks: Array[int] = split[1]
	if sock_top < 1.0e8:
		socks = _clip(soup, socks, _above(sock_top))[1]

	var cut: Dictionary = {
		SURFACE_JERSEY: jersey,
		SURFACE_SLEEVES: sleeves,
		SURFACE_SHORTS: shorts,
		SURFACE_SOCKS: socks,
		SURFACE_BOOTS: boots,
	}
	var out := ArrayMesh.new()
	out.resource_name = "player_recut"
	for entry in plan:
		var entry_name: String = entry["name"]
		var arrays: Array = entry["arrays"]
		if not entry_name.is_empty():
			arrays = _emit_surface(soup, cut.get(entry_name, [] as Array[int]))
			if arrays.is_empty():
				push_warning("CharacterModels: garment '%s' came out empty, keeping the imported cut." % entry_name)
				return null
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, _surface_flags(arrays))
		out.surface_set_material(out.get_surface_count() - 1, entry["material"])
	_kit_mesh = _split_jersey_surface(_split_face_surface(_free_head_grip(out)))
	return _kit_mesh


## Takes the enlarged head's grip off the shirt.
##
## The skull is drawn at `HEAD_SCALE` by scaling one BONE, and a bone moves every
## vertex that carries any of its weight. The MakeHuman rig lets the head bone
## reach a good ten centimetres down the neck, and the kit shell inherited those
## weights when it was modelled off the body, so the top of the shirt carried a
## share of the head. Doubling the head therefore doubled the collar with it: the
## neck of the jersey opened out into a torn orange funnel standing up around the
## neck, with the teeth of the old neck hole flaring off it. It was invisible only
## for as long as the head was ALSO drawn low enough to sit inside it.
##
## So the head's influence is faded out over the band between the top of the cloth
## and the floor of the skull. Below the collar nothing feels the head at all;
## above the jaw everything does; and in between the neck stretches, which is the
## one part of a bobble head that is allowed to.
##
## The weight taken off the head is handed to the bones the vertex already used,
## in proportion, so no vertex changes which bones it belongs to and none of them
## can end up unnormalised, which is the classic way a re-weighted vertex drifts
## towards the origin the moment the body moves.
##
## Like `_shape`, this is ONE function of the bind position applied to ALL seven
## surfaces, so the shell and the skin under it can never disagree about it.
static func _free_head_grip(source: ArrayMesh) -> ArrayMesh:
	if _head_binds.is_empty() or _skull_floor <= 0.0:
		return source
	var cloth_top := -1.0e9
	for s in source.get_surface_count():
		var material := source.surface_get_material(s)
		var surface_name := material.resource_name if material != null else ""
		if not _KIT.has(surface_name):
			continue
		var arrays: Array = source.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_VERTEX or arrays[Mesh.ARRAY_VERTEX] == null:
			continue
		for v in arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array:
			cloth_top = maxf(cloth_top, v.y)
	if cloth_top <= -1.0e8 or cloth_top >= _skull_floor:
		push_warning("CharacterModels: the cloth reaches %.3f against a jaw at %.3f, the collar keeps the head's grip."
			% [cloth_top, _skull_floor])
		return source
	var out := ArrayMesh.new()
	out.resource_name = source.resource_name
	for s in source.get_surface_count():
		var arrays: Array = source.surface_get_arrays(s)
		_taper_head_weights(arrays, cloth_top, _skull_floor)
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, _surface_flags(arrays))
		out.surface_set_material(out.get_surface_count() - 1, source.surface_get_material(s))
	return out


## Scales every head influence of one surface by a smoothstep in height, and gives
## what it took to the other bones of the same vertex. See `_free_head_grip`.
static func _taper_head_weights(arrays: Array, low: float, high: float) -> void:
	if arrays.size() <= Mesh.ARRAY_WEIGHTS or arrays[Mesh.ARRAY_BONES] == null \
			or arrays[Mesh.ARRAY_WEIGHTS] == null:
		return
	var vertex: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var bones: PackedInt32Array = arrays[Mesh.ARRAY_BONES]
	var weights: PackedFloat32Array = arrays[Mesh.ARRAY_WEIGHTS]
	if vertex.is_empty() or bones.size() % vertex.size() != 0:
		return
	var influences := bones.size() / vertex.size()
	for i in vertex.size():
		var keep := smoothstep(low, high, vertex[i].y)
		if keep >= 0.9999:
			continue
		var head_share := 0.0
		var other := 0.0
		for k in influences:
			var w := weights[i * influences + k]
			if _head_binds.has(bones[i * influences + k]):
				head_share += w
			else:
				other += w
		if head_share <= 0.000001:
			continue
		var freed := head_share * (1.0 - keep)
		# A vertex with nothing but head in it keeps what it has: shrinking its only
		# influence towards zero would collapse it onto the skeleton's origin.
		if other <= 0.000001:
			continue
		var boost := (other + freed) / other
		for k in influences:
			var index := i * influences + k
			if _head_binds.has(bones[index]):
				weights[index] *= keep
			else:
				weights[index] *= boost
	arrays[Mesh.ARRAY_WEIGHTS] = weights


## Splits the head triangles out of the body's skin primitive. MakeHuman packs
## parts of the neck over the same UV texels as the face; one shared material
## therefore repeats eyebrows and lips at the collar. Separate surfaces keep the
## original vertices, indices, skin weights and geometry exactly, while allowing
## only the head to sample the photographic atlas.
##
## WHERE the split goes is the whole difficulty, and it was measured rather than
## chosen. The two surfaces do not merely have different UVs: on the keeper one
## samples a photograph of a face and the other is a flat `Palette.SKIN`, which are
## two different complexions, so the boundary between them is a VISIBLE TONE STEP.
## The test is per triangle, so that step is a saw tooth a centimetre deep.
##
## Left at the base of the neck it sat about a centimetre under the collar edge,
## which sounds safe and is not: a collar is an OPENING, and any camera above the
## keeper looks straight down into it. That is the ragged pale wedge beside the
## neck, and it was there before the head was ever enlarged.
##
## So the split now runs `_FACE_SEAM_DROP` BELOW the lowest point of the collar
## edge, which this function measures off the cloth it was handed. Everything the
## collar can expose is then one surface with one complexion, and the seam, teeth
## and all, is buried under fabric. What it costs is that the neck under the shirt
## samples face texels, which is the very repeat this split exists to avoid: it is
## the right trade because nobody can see under the shirt.
static func _split_face_surface(source_mesh: ArrayMesh) -> ArrayMesh:
	var seam := _collar_floor(source_mesh) - _FACE_SEAM_DROP
	var out := ArrayMesh.new()
	out.resource_name = source_mesh.resource_name
	for surface in source_mesh.get_surface_count():
		var material := source_mesh.surface_get_material(surface)
		var surface_name := material.resource_name if material != null else ""
		var arrays := source_mesh.surface_get_arrays(surface)
		if surface_name != SURFACE_SKIN:
			out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, _surface_flags(arrays))
			out.surface_set_material(out.get_surface_count() - 1, material)
			continue

		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		var body_indices := PackedInt32Array()
		var face_indices := PackedInt32Array()
		for tri in int(indices.size() / 3):
			var ia := indices[tri * 3]
			var ib := indices[tri * 3 + 1]
			var ic := indices[tri * 3 + 2]
			var centre_y := (vertices[ia].y + vertices[ib].y + vertices[ic].y) / 3.0
			var target := face_indices if centre_y > seam else body_indices
			target.append(ia)
			target.append(ib)
			target.append(ic)

		var body_arrays: Array = arrays.duplicate(true)
		body_arrays[Mesh.ARRAY_INDEX] = body_indices
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, body_arrays, [], {}, _surface_flags(body_arrays))
		out.surface_set_material(out.get_surface_count() - 1, material)

		var face_arrays: Array = arrays.duplicate(true)
		face_arrays[Mesh.ARRAY_INDEX] = face_indices
		var face_material := material.duplicate() as Material
		face_material.resource_name = SURFACE_FACE
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, face_arrays, [], {}, _surface_flags(face_arrays))
		out.surface_set_material(out.get_surface_count() - 1, face_material)
	return out


## Lowest point of the collar edge, in the model's own units: the top of the cloth
## in the narrow column of x the neck stands in. The collar was cut on a horizontal
## plane by `_recut_kit`, so this is one number and not an average of a ragged
## curve. Falls back to a height under the whole figure when there is no cloth,
## which puts the seam where it has always been rather than somewhere invented.
static func _collar_floor(mesh: ArrayMesh) -> float:
	var out := -1.0e9
	for s in mesh.get_surface_count():
		var material := mesh.surface_get_material(s)
		var surface_name := material.resource_name if material != null else ""
		if surface_name != SURFACE_JERSEY and not _KIT.has(surface_name):
			continue
		var arrays: Array = mesh.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_VERTEX or arrays[Mesh.ARRAY_VERTEX] == null:
			continue
		for v in arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array:
			if absf(v.x) < _COLLAR_COLUMN:
				out = maxf(out, v.y)
	return out if out > -1.0e8 else 1.47 + _FACE_SEAM_DROP


## The imported torso is one primitive, so one texture used to put the squad
## number on both sides. Split it along the body's local Z seam: the model faces
## +Z, hence positive-Z triangles are the front and negative-Z ones the back.
## No vertices are moved and all skin weights remain intact.
static func _split_jersey_surface(source_mesh: ArrayMesh) -> ArrayMesh:
	var out := ArrayMesh.new()
	out.resource_name = source_mesh.resource_name
	for surface in source_mesh.get_surface_count():
		var material := source_mesh.surface_get_material(surface)
		var surface_name := material.resource_name if material != null else ""
		var arrays := source_mesh.surface_get_arrays(surface)
		if surface_name != SURFACE_JERSEY:
			out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, _surface_flags(arrays))
			out.surface_set_material(out.get_surface_count() - 1, material)
			continue

		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		var front_indices := PackedInt32Array()
		var back_indices := PackedInt32Array()
		for tri in int(indices.size() / 3):
			var ia := indices[tri * 3]
			var ib := indices[tri * 3 + 1]
			var ic := indices[tri * 3 + 2]
			var centre_z := (vertices[ia].z + vertices[ib].z + vertices[ic].z) / 3.0
			var target := front_indices if centre_z >= 0.0 else back_indices
			target.append(ia)
			target.append(ib)
			target.append(ic)

		var back_uvs := _jersey_back_uvs(arrays, front_indices, back_indices)
		for part in [
			[SURFACE_JERSEY_FRONT, front_indices],
			[SURFACE_JERSEY_BACK, back_indices],
		]:
			var part_arrays: Array = arrays.duplicate(true)
			part_arrays[Mesh.ARRAY_INDEX] = part[1]
			if part[0] == SURFACE_JERSEY_BACK and not back_uvs.is_empty():
				part_arrays[Mesh.ARRAY_TEX_UV] = back_uvs
			var part_material := material.duplicate() as Material
			part_material.resource_name = part[0]
			out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, part_arrays, [], {}, _surface_flags(part_arrays))
			out.surface_set_material(out.get_surface_count() - 1, part_material)
	return out


## Projects the original front artwork continuously over the rear torso. A
## nearest-vertex transfer looked plausible from the penalty camera but tore the
## lettering in close-up because the front and back have different topology.
## The planar map uses the exact UV and body bounds of the clean front unwrap;
## X is reversed so lettering remains readable after the half-turn around Y.
static func _jersey_back_uvs(arrays: Array, front_indices: PackedInt32Array,
		back_indices: PackedInt32Array) -> PackedVector2Array:
	var source_uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
	if source_uvs.is_empty():
		return source_uvs
	var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var body_min := Vector2(INF, INF)
	var body_max := Vector2(-INF, -INF)
	var uv_min := Vector2(INF, INF)
	var uv_max := Vector2(-INF, -INF)
	var measured: Dictionary = {}
	for index in front_indices:
		if measured.has(index):
			continue
		measured[index] = true
		var point := vertices[index]
		body_min = body_min.min(Vector2(point.x, point.y))
		body_max = body_max.max(Vector2(point.x, point.y))
		uv_min = uv_min.min(source_uvs[index])
		uv_max = uv_max.max(source_uvs[index])
	var body_span := body_max - body_min
	if body_span.x <= 0.000001 or body_span.y <= 0.000001:
		return source_uvs
	var out := source_uvs.duplicate()
	var mapped: Dictionary = {}
	for index in back_indices:
		if mapped.has(index):
			continue
		mapped[index] = true
		var point := vertices[index]
		var across := clampf((point.x - body_min.x) / body_span.x, 0.0, 1.0)
		var down := clampf((body_max.y - point.y) / body_span.y, 0.0, 1.0)
		out[index] = Vector2(
			lerpf(uv_max.x, uv_min.x, across),
			lerpf(uv_min.y, uv_max.y, down))
	return out


## The same point with its x folded onto +X. Every arm measurement is taken on
## one side and mirrored, so the two sides cannot come out different.
static func _mirrored(p: Vector3) -> Vector3:
	return Vector3(absf(p.x), p.y, p.z)


static func _lowest(soup: _KitSoup, tris: Array[int]) -> float:
	var out := 1.0e9
	for i in tris:
		out = minf(out, soup.vertex[i].y)
	return out


static func _highest(soup: _KitSoup, tris: Array[int]) -> float:
	var out := -1.0e9
	for i in tris:
		out = maxf(out, soup.vertex[i].y)
	return out


## Positive below a height. Used for the shirt hem and the shorts hem.
static func _below(height: float) -> Callable:
	return func(p: Vector3) -> float: return height - p.y


## Positive above a height. Used for the sock tops.
static func _above(height: float) -> Callable:
	return func(p: Vector3) -> float: return p.y - height


## Positive past a plane through `origin` facing `axis`. Used for the sleeve
## rings and the cuffs.
static func _beyond(origin: Vector3, axis: Vector3) -> Callable:
	return func(p: Vector3) -> float: return (p - origin).dot(axis)


## Positive inside the neck opening: above `floor_y` across the neck, and then
## above a floor that CLIMBS out over each shoulder. Free in z, because nothing
## but the collar band lives in that window. See point 3 of `_recut_kit` for why a
## flat floor across the neck and not a round cutter.
##
## The climb is the second half of the shape and it earns its place. The flat floor
## alone is a SLOT with two upright walls, and the shell it cuts is a nearly
## horizontal sheet over the trapezius that keeps rising outboard of those walls:
## the wall therefore crosses the sheet at a glancing angle and leaves a long
## pointed flap of shirt standing up on each shoulder. Two of them, close up, read
## as a torn garment. Letting the floor climb at `_COLLAR_RISE` instead means the
## cut runs OUT ALONG the cloth until it meets the top of it and there is nothing
## left to leave behind, which is the same thing a real neckline does.
##
## The climb starts with a quadratic ease over `radius` so the neckline has no kink
## where the two halves meet: a kink in a hem reads as a crease at any distance.
static func _inside_collar(half_x: float, floor_y: float, radius: float) -> Callable:
	var flat_x := maxf(half_x - radius, 0.0)
	var ease := maxf(radius, 0.001)
	return func(p: Vector3) -> float:
		var out := absf(p.x) - flat_x
		var lift := 0.0
		if out > 0.0:
			lift = _COLLAR_RISE * (out * out / (2.0 * ease) if out < ease
				else out - ease * 0.5)
		return p.y - (floor_y + lift)


## The only surface flag that matters here: whether the skin binding carries
## eight influences per vertex instead of four. Read off the arrays rather than
## copied from the source format, because a wrong answer silently corrupts every
## vertex of the surface.
static func _surface_flags(arrays: Array) -> int:
	if arrays[Mesh.ARRAY_BONES] == null:
		return 0
	var bones: PackedInt32Array = arrays[Mesh.ARRAY_BONES]
	var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	if verts.size() > 0 and bones.size() / verts.size() == 8:
		return Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
	return 0


## Vertices sitting on an OPEN edge of a triangle list, that is on an edge only
## one triangle uses. Those are the ragged hems the file shipped, and measuring
## them is how every threshold below stays tied to this mesh instead of to a
## number somebody typed. Welded by position: the shell arrives as separate
## primitives that do not share vertex indices along their old seams.
static func _open_vertices(soup: _KitSoup, tris: Array[int]) -> Array[int]:
	var id_of: Dictionary = {}
	var welded: Array[int] = []
	var next_id := 0
	for i in tris:
		var key := _point_key(soup.vertex[i])
		if not id_of.has(key):
			id_of[key] = next_id
			next_id += 1
		welded.append(id_of[key])
	var uses: Dictionary = {}
	for t in range(0, welded.size(), 3):
		for k in 3:
			var a: int = welded[t + k]
			var b: int = welded[t + (k + 1) % 3]
			var edge := "%d_%d" % [mini(a, b), maxi(a, b)]
			uses[edge] = int(uses.get(edge, 0)) + 1
	var lonely: Dictionary = {}
	for edge in uses:
		if int(uses[edge]) != 1:
			continue
		for half in (edge as String).split("_"):
			lonely[int(half)] = true
	var out: Array[int] = []
	var taken: Dictionary = {}
	for n in welded.size():
		if lonely.has(welded[n]) and not taken.has(welded[n]):
			taken[welded[n]] = true
			out.append(tris[n])
	return out


## Pushes a surface through a triangle list. `field` is positive on the side that
## comes back first. Returns [Array[int] positive, Array[int] negative].
##
## Triangles that straddle the surface are cut on it, and the vertex a cut
## creates is SHARED by the two sides and by the neighbouring triangle, so the
## seam is one clean edge with no crack, whatever the triangulation does around
## it. A curved field is cut where the field interpolates to zero along the edge,
## which on a 3 cm shell is a fraction of a millimetre off the true surface and,
## far more importantly, is the SAME point for both triangles sharing that edge.
static func _clip(soup: _KitSoup, tris: Array[int], field: Callable) -> Array:
	var positive: Array[int] = []
	var negative: Array[int] = []
	var made: Dictionary = {}
	for t in range(0, tris.size(), 3):
		var corner: Array[int] = [tris[t], tris[t + 1], tris[t + 2]]
		var depth: Array[float] = [0.0, 0.0, 0.0]
		var above := 0
		var below := 0
		for k in 3:
			depth[k] = field.call(soup.vertex[corner[k]])
			if depth[k] > _CLIP_EPSILON:
				above += 1
			elif depth[k] < -_CLIP_EPSILON:
				below += 1
		if below == 0:
			positive.append_array(corner)
			continue
		if above == 0:
			negative.append_array(corner)
			continue
		var poly_pos: Array[int] = []
		var poly_neg: Array[int] = []
		for k in 3:
			var a := corner[k]
			var b := corner[(k + 1) % 3]
			var da := depth[k]
			var db := depth[(k + 1) % 3]
			if da >= -_CLIP_EPSILON:
				poly_pos.append(a)
			if da <= _CLIP_EPSILON:
				poly_neg.append(a)
			if absf(da) > _CLIP_EPSILON and absf(db) > _CLIP_EPSILON \
					and (da > 0.0) != (db > 0.0):
				var mid := _cut_vertex(soup, made, a, b, da, db)
				poly_pos.append(mid)
				poly_neg.append(mid)
		_fan(positive, poly_pos)
		_fan(negative, poly_neg)
	return [positive, negative]


## Splits a triangle list into [the piece reaching furthest along `axis`,
## everything else].
##
## The far side of a sleeve plane holds two disconnected pieces: the arm running
## out to the wrist, and a slice of lower chest the slanted plane also caught.
## The inside of the collar prism is the same story with the collar band and
## whatever else the prism happened to enclose. Keeping only the piece that
## reaches furthest along the axis of the cut is what makes both cuts safe.
## Connectivity is measured on welded POSITIONS, because the shell arrives as
## separate primitives that do not share vertex indices along their old seams.
static func _pick_piece(soup: _KitSoup, tris: Array[int], origin: Vector3,
		axis: Vector3) -> Array:
	var keep: Array[int] = []
	var drop: Array[int] = []
	if tris.is_empty():
		return [keep, drop]
	var node: Dictionary = {}
	var parent: Array[int] = []
	var of_triangle: Array[int] = []
	for t in range(0, tris.size(), 3):
		var first := -1
		for k in 3:
			var key := _point_key(soup.vertex[tris[t + k]])
			if not node.has(key):
				node[key] = parent.size()
				parent.append(parent.size())
			var id: int = node[key]
			if first < 0:
				first = id
			else:
				_join(parent, first, id)
		of_triangle.append(first)
	var best := -1
	var best_reach := -1.0e9
	for i in tris.size():
		var reach := (soup.vertex[tris[i]] - origin).dot(axis)
		if reach > best_reach:
			best_reach = reach
			best = node[_point_key(soup.vertex[tris[i]])]
	best = _root(parent, best)
	for i in of_triangle.size():
		if _root(parent, of_triangle[i]) == best:
			keep.append(tris[i * 3])
			keep.append(tris[i * 3 + 1])
			keep.append(tris[i * 3 + 2])
		else:
			drop.append(tris[i * 3])
			drop.append(tris[i * 3 + 1])
			drop.append(tris[i * 3 + 2])
	return [keep, drop]


static func _root(parent: Array[int], i: int) -> int:
	while parent[i] != i:
		parent[i] = parent[parent[i]]
		i = parent[i]
	return i


static func _join(parent: Array[int], a: int, b: int) -> void:
	var ra := _root(parent, a)
	var rb := _root(parent, b)
	if ra != rb:
		parent[rb] = ra


## The vertex where one edge meets the cut, created once and then reused.
##
## Keyed on the two POSITIONS and not on the two indices: the garments were
## exported as separate primitives, so the two triangles that share an edge
## across a former seam do NOT share a vertex index, and keying on the index
## would cut the same edge twice at two subtly different points. The parameter is
## computed in a canonical order for the same reason.
static func _cut_vertex(soup: _KitSoup, made: Dictionary, a: int, b: int,
		da: float, db: float) -> int:
	var key_a := _point_key(soup.vertex[a])
	var key_b := _point_key(soup.vertex[b])
	var forward := key_a < key_b
	var key := (key_a + "|" + key_b) if forward else (key_b + "|" + key_a)
	if made.has(key):
		return made[key]
	var low := a if forward else b
	var high := b if forward else a
	var d_low := da if forward else db
	var d_high := db if forward else da
	var span := d_low - d_high
	var t := 0.5 if absf(span) < 1.0e-12 else clampf(d_low / span, 0.0, 1.0)
	var here := soup.vertex[low] + (soup.vertex[high] - soup.vertex[low]) * t
	var index := soup.split_edge(low, high, t, here)
	made[key] = index
	return index


## Fans a convex polygon of 3 or 4 corners into triangles, winding preserved.
static func _fan(out: Array[int], poly: Array[int]) -> void:
	for i in range(1, poly.size() - 1):
		out.append(poly[0])
		out.append(poly[i])
		out.append(poly[i + 1])


static func _point_key(p: Vector3) -> String:
	return "%d_%d_%d" % [roundi(p.x * _WELD), roundi(p.y * _WELD), roundi(p.z * _WELD)]


## Turns a triangle list over the pool into a standalone surface array set,
## keeping only the vertices it actually uses.
static func _emit_surface(soup: _KitSoup, tris: Array[int]) -> Array:
	if tris.is_empty():
		return []
	var seen: Dictionary = {}
	var vertex := PackedVector3Array()
	var normal := PackedVector3Array()
	var tangent := PackedFloat32Array()
	var uv := PackedVector2Array()
	var bones := PackedInt32Array()
	var weights := PackedFloat32Array()
	var index := PackedInt32Array()
	for i in tris:
		if not seen.has(i):
			seen[i] = vertex.size()
			vertex.append(soup.vertex[i])
			if soup.normal.size() > 0:
				normal.append(soup.normal[i])
			if soup.tangent.size() > 0:
				for k in 4:
					tangent.append(soup.tangent[i * 4 + k])
			if soup.uv.size() > 0:
				uv.append(soup.uv[i])
			for k in soup.influences:
				bones.append(soup.bones[i * soup.influences + k])
				weights.append(soup.weights[i * soup.influences + k])
		index.append(seen[i])
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertex
	if normal.size() > 0:
		arrays[Mesh.ARRAY_NORMAL] = normal
	if tangent.size() > 0:
		arrays[Mesh.ARRAY_TANGENT] = tangent
	if uv.size() > 0:
		arrays[Mesh.ARRAY_TEX_UV] = uv
	if bones.size() > 0:
		arrays[Mesh.ARRAY_BONES] = bones
		arrays[Mesh.ARRAY_WEIGHTS] = weights
	arrays[Mesh.ARRAY_INDEX] = index
	return arrays


# --- materials ----------------------------------------------------------------


## Paints the seven surfaces of one figure.
##
## The override goes on the MeshInstance3D, never on the Mesh: surface materials
## belong to the imported resource and are shared by every instance of it, so
## writing there would dress the shooter in the keeper's lime.
##
## The body still uses procedural materials, while the three clothing surfaces
## sample a role-specific atlas with woven fabric, sponsor artwork and numbers.
static func _paint(mesh_instance: MeshInstance3D, role: int) -> void:
	var mesh := mesh_instance.mesh
	if mesh == null:
		return
	var keeper := role == ROLE_KEEPER
	for s in mesh.get_surface_count():
		var source := mesh.surface_get_material(s)
		var surface_name := source.resource_name if source != null else ""
		mesh_instance.set_surface_override_material(s, _kit_material(surface_name, keeper))


## Hangs the cap of hair off the head bone. See `_HAIR_THICK`.
##
## A `BoneAttachment3D` follows the posed bone for free, so the cap stays on the
## crown through a full horizontal dive without a line of per frame code. It sits
## under the skeleton, so it inherits the rig's scale like everything else and
## needs no counter scale, unlike the weapon in the sibling CALL OF WAR project.
## It inherits the enlarged head's scale the same way, which is what keeps a cap
## measured in the head bone's own units the right size on a doubled skull.
static func _add_hair(skeleton: Skeleton3D, mesh: Mesh) -> void:
	if skeleton.find_bone("head") < 0:
		return
	var cap := _hair_mesh(mesh, skeleton)
	if cap == null:
		return
	var attach := BoneAttachment3D.new()
	attach.name = "Hair"
	attach.bone_name = "head"
	skeleton.add_child(attach)

	var mesh_instance := MeshInstance3D.new()
	mesh_instance.name = "HairMesh"
	mesh_instance.mesh = cap
	mesh_instance.material_override = _cloth(Palette.HAIR, 0.72, 0.30, 0.0, 0.0)
	mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	attach.add_child(mesh_instance)


## The cap itself: the skull's own triangles above the hairline, expressed in the
## head bone's frame and pushed out along their own normals. See `_HAIR_THICK` for
## why it is built this way rather than parked on the crown as a primitive.
##
## The skull is taken as the geometry the SKIN and FACE surfaces put above the
## hairline, not as the geometry the head bone owns: the cut is a height and the
## height is measured on this very mesh, so a re-export moves the cap with it.
## Rigid is legitimate here because every vertex this keeps belongs outright to
## the head bone, which is the same test `_head_floor` makes.
static func _hair_mesh(mesh: Mesh, skeleton: Skeleton3D) -> ArrayMesh:
	if _hair_cap != null:
		return _hair_cap
	var head := skeleton.find_bone("head")
	if mesh == null or head < 0:
		return null
	var to_local := skeleton.get_bone_global_rest(head).affine_inverse()

	# Pass one: everything the two skin surfaces hold, in the head bone's frame.
	var pieces: Array = []
	var crown := -1.0e9
	for s in mesh.get_surface_count():
		var material := mesh.surface_get_material(s)
		var surface_name := material.resource_name if material != null else ""
		if surface_name != SURFACE_SKIN and surface_name != SURFACE_FACE:
			continue
		var arrays: Array = mesh.surface_get_arrays(s)
		if arrays.size() <= Mesh.ARRAY_INDEX or arrays[Mesh.ARRAY_VERTEX] == null \
				or arrays[Mesh.ARRAY_NORMAL] == null or arrays[Mesh.ARRAY_INDEX] == null:
			continue
		var verts := PackedVector3Array()
		var norms := PackedVector3Array()
		for v in arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array:
			var p := to_local * v
			verts.append(p)
			crown = maxf(crown, p.y)
		for n in arrays[Mesh.ARRAY_NORMAL] as PackedVector3Array:
			norms.append((to_local.basis * n).normalized())
		pieces.append([verts, norms, arrays[Mesh.ARRAY_INDEX] as PackedInt32Array])
	if pieces.is_empty() or crown <= 0.0:
		push_warning("CharacterModels: no skull surface to cut the hair from, the figures stay bald.")
		return null

	# Pass two: the box the cranium occupies, so the hairline can be read as an
	# azimuth about it instead of about a nose.
	var z_low := 1.0e9
	var z_high := -1.0e9
	var x_half := 0.0
	for piece in pieces:
		for p in piece[0] as PackedVector3Array:
			if p.y < crown * _HAIR_CRANIUM:
				continue
			z_low = minf(z_low, p.z)
			z_high = maxf(z_high, p.z)
			x_half = maxf(x_half, absf(p.x))
	if z_low > z_high or x_half <= 0.0:
		return null
	var head_box := Vector3(x_half, (z_low + z_high) * 0.5, (z_high - z_low) * 0.5)
	if head_box.z <= 0.0:
		return null

	# Pass three: keep every triangle the hairline crosses or stands above, and
	# offset each of its vertices by however much hair there is at that height.
	var out_v := PackedVector3Array()
	var out_n := PackedVector3Array()
	var out_i := PackedInt32Array()
	var remap: Dictionary = {}
	var keep_below := -crown * _HAIR_BURY
	for slot in pieces.size():
		var piece: Array = pieces[slot]
		var verts: PackedVector3Array = piece[0]
		var norms: PackedVector3Array = piece[1]
		var indices: PackedInt32Array = piece[2]
		for tri in int(indices.size() / 3):
			var corner := PackedInt32Array([
				indices[tri * 3], indices[tri * 3 + 1], indices[tri * 3 + 2]])
			var top := -1.0e9
			for i in corner:
				top = maxf(top, _hair_above(verts[i], crown, head_box))
			if top <= keep_below:
				continue
			for i in corner:
				var key := slot * 1000000 + i
				if not remap.has(key):
					var p: Vector3 = verts[i]
					var n: Vector3 = norms[i]
					remap[key] = out_v.size()
					out_v.append(p + n * _hair_offset(
						_hair_above(p, crown, head_box), crown))
					out_n.append(n)
				out_i.append(int(remap[key]))
	if out_i.is_empty():
		push_warning("CharacterModels: the hairline cut nothing off the skull, the figures stay bald.")
		return null

	var cap_arrays: Array = []
	cap_arrays.resize(Mesh.ARRAY_MAX)
	cap_arrays[Mesh.ARRAY_VERTEX] = out_v
	cap_arrays[Mesh.ARRAY_NORMAL] = out_n
	cap_arrays[Mesh.ARRAY_INDEX] = out_i
	var cap := ArrayMesh.new()
	cap.resource_name = "hair"
	cap.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, cap_arrays)
	_hair_cap = cap
	return cap


## How far a skull point stands above the hairline, in the head bone's frame.
## `box` carries the cranium's half width in x, its centre in z and its half depth
## in z, in that order. The hairline is read off the AZIMUTH about that box: high
## across the forehead, lowest round the temple, a little back up at the nape,
## exactly as a real one runs. Height alone would draw a swimming cap.
static func _hair_above(p: Vector3, crown: float, box: Vector3) -> float:
	var forward := clampf((p.z - box.y) / box.z, -1.0, 1.0)
	var sideways := clampf(absf(p.x) / box.x, 0.0, 1.0)
	# 0 straight ahead, 1 out at the ear, 2 round the back.
	var turn := atan2(sideways, forward) * 2.0 / PI
	var drop := lerpf(_HAIR_DROP_FRONT, _HAIR_DROP_SIDE,
			smoothstep(0.0, 1.0, turn)) if turn <= 1.0 \
		else lerpf(_HAIR_DROP_SIDE, _HAIR_DROP_BACK,
			smoothstep(0.0, 1.0, turn - 1.0))
	return p.y - crown * (1.0 - drop)


## Hair thickness at a point that far above the hairline. It reaches `_HAIR_THICK`
## over the crown and it is `_HAIR_BITE` UNDER the drawn skin (`_SKIN_SHRINK`) at
## the hairline itself, so the rim of the cap ends up inside the head and the
## visible edge is the curve where the two surfaces cross. Smoothstepped rather
## than linear: a kink in this profile is a crease across the temple.
static func _hair_offset(above: float, crown: float) -> float:
	var u := clampf(above / (crown * _HAIR_FEATHER), 0.0, 1.0)
	return lerpf(_SKIN_SHRINK - _HAIR_BITE, _HAIR_THICK, smoothstep(0.0, 1.0, u))


## The MakeHuman body mesh carries eyelid shells but no eyeball geometry. A
## photographic eye painted directly onto those closed shells reads as a bulge,
## so two tiny bone-attached eyes supply the missing depth while the face atlas
## provides the surrounding lids, brows and complexion.
static func _add_eyes(skeleton: Skeleton3D) -> void:
	if skeleton.find_bone("head") < 0:
		return
	var attach := BoneAttachment3D.new()
	attach.name = "Eyes"
	attach.bone_name = "head"
	skeleton.add_child(attach)

	var white := _base()
	white.albedo_color = Color(0.32, 0.29, 0.25)
	white.roughness = 0.34
	white.metallic_specular = 0.50
	var iris := _base()
	iris.albedo_color = Color(0.035, 0.014, 0.009)
	iris.roughness = 0.24
	iris.metallic_specular = 0.62

	for side in [-1.0, 1.0]:
		var globe_mesh := SphereMesh.new()
		globe_mesh.radius = 0.0115
		globe_mesh.height = 0.023
		globe_mesh.radial_segments = 20
		globe_mesh.rings = 10
		var globe := MeshInstance3D.new()
		globe.name = "EyeL" if side < 0.0 else "EyeR"
		globe.mesh = globe_mesh
		globe.material_override = white
		globe.position = Vector3(_EYE_X * side, _EYE_Y, _EYE_Z)
		globe.scale = Vector3(1.20, 0.50, 0.40)
		attach.add_child(globe)

		var iris_mesh := SphereMesh.new()
		iris_mesh.radius = 0.0045
		iris_mesh.height = 0.009
		iris_mesh.radial_segments = 16
		iris_mesh.rings = 8
		var pupil := MeshInstance3D.new()
		pupil.name = "IrisL" if side < 0.0 else "IrisR"
		pupil.mesh = iris_mesh
		pupil.material_override = iris
		pupil.position = Vector3(_EYE_X * side, _EYE_Y, _EYE_Z + 0.006)
		pupil.scale = Vector3(0.90, 0.90, 0.35)
		attach.add_child(pupil)


## Hangs one padded solid off each wrist, in place of the hand surface the
## materials switch off. See the block above `_MITT_KEEPER`.
##
## The two sides are built from the SAME measured frame, the -X one by negating x
## in the axis and the normal and then rebuilding the third vector with a cross
## product. Mirroring all three instead would hand the mesh a left handed basis and
## draw the glove inside out, which back face culling turns into a hole.
static func _add_mitts(skeleton: Skeleton3D, role: int) -> void:
	if _hand_axis == Vector3.ZERO or _hand_length <= 0.0:
		return
	var keeper := role == ROLE_KEEPER
	var shape: Vector3 = _MITT_KEEPER if keeper else _MITT_SHOOTER
	var reach: float = float(_model_metrics.get("hand_reach", _hand_length * 0.5)) \
		* (_MITT_REACH_KEEPER if keeper else _MITT_REACH_SHOOTER)
	var half := Vector3(shape.x * _hand_radius, shape.y * _hand_radius,
		shape.z * _hand_length)
	for side in ["L", "R"]:
		var bone := "wrist.%s" % side
		if skeleton.find_bone(bone) < 0:
			continue
		var axis := _rest_dir(skeleton, bone)
		if axis == Vector3.ZERO:
			continue
		var normal := _hand_normal
		if side == "R":
			normal = Vector3(-normal.x, normal.y, normal.z)
		# The measured normal was swept in the plane perpendicular to the LEFT
		# hand's axis, so re-square it against this side's own axis before use.
		normal = (normal - axis * normal.dot(axis))
		if normal.length_squared() < 0.000001:
			continue
		normal = normal.normalized()
		var across := normal.cross(axis).normalized()

		var attach := BoneAttachment3D.new()
		attach.name = "Mitt%s" % side
		attach.bone_name = bone
		skeleton.add_child(attach)

		# The solid is sized in the MESH and only oriented by the basis, with a
		# single stretch along the fingers for the third semi axis a SphereMesh
		# cannot express. Building a unit sphere and scaling it in the transform
		# draws the same picture and lies about the figure: anything that measures
		# a body by walking its meshes, `tests/test_character_models.gd` included,
		# would read a metre wide hand across every height band at once.
		var ball := SphereMesh.new()
		ball.radius = half.x
		ball.height = half.y * 2.0
		ball.radial_segments = 20
		ball.rings = 10
		var mesh_instance := MeshInstance3D.new()
		mesh_instance.name = "MittMesh%s" % side
		mesh_instance.mesh = ball
		mesh_instance.material_override = _mitt_material(keeper)
		mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		attach.add_child(mesh_instance)
		mesh_instance.transform = Transform3D(
			Basis(across, normal, axis * (half.z / maxf(half.x, 0.001))), axis * reach)


## The glove, or the bare fist. The glove keeps the colour and the finish the hand
## surface used to carry, so nothing about the keeper's read changes but the shape.
static func _mitt_material(keeper: bool) -> StandardMaterial3D:
	if keeper:
		return _cloth(Palette.KEEPER_GLOVE, 0.60, 0.45, 0.30, 0.0)
	var mat := _skin_material()
	# `_skin_material` shrinks the skin 4 mm to clear the kit shell. There is no
	# shell over a fist, and 4 mm off a 4 cm solid is a visible bite.
	mat.grow = false
	mat.grow_amount = 0.0
	return mat


static func _kit_material(surface_name: String, keeper: bool) -> StandardMaterial3D:
	# Named `atlas` and not `kit_texture`: a local of that name would shadow the
	# static kit_texture() this calls. Null when assets/ is absent, which _cloth
	# already treats as "flat Palette colour".
	var atlas: Texture2D = kit_texture(keeper)
	var front_atlas: Texture2D = front_kit_texture(keeper)
	match surface_name:
		SURFACE_SKIN:
			return _skin_material()
		SURFACE_FACE:
			return _skin_material(keeper_skin_texture() if keeper else null)
		SURFACE_HANDS:
			# Switched off on BOTH figures and replaced by `_add_mitts`. The mesh
			# stays in place rather than being cut out, which is deliberate: it is
			# what `hand_reach` is measured from, and that measurement is what the
			# arms are solved against.
			return _hidden()
		SURFACE_JERSEY_FRONT:
			if keeper:
				return _cloth(Palette.KEEPER_JERSEY, 0.86, 0.34, 0.55, _KIT_GROW, front_atlas)
			return _cloth(Palette.SHOOTER_JERSEY, 0.86, 0.34, 0.55, _KIT_GROW, front_atlas)
		SURFACE_JERSEY_BACK, SURFACE_JERSEY:
			if keeper:
				return _cloth(Palette.KEEPER_JERSEY, 0.86, 0.34, 0.55, _KIT_GROW, atlas)
			return _cloth(Palette.SHOOTER_JERSEY, 0.86, 0.34, 0.55, _KIT_GROW, atlas)
		SURFACE_SLEEVES:
			# Long sleeves are a keeper's, an outfield shirt stops at the bicep.
			if keeper:
				return _cloth(Palette.KEEPER_JERSEY, 0.86, 0.34, 0.55, _KIT_GROW, atlas)
			return _hidden()
		SURFACE_SHORTS:
			if keeper:
				return _cloth(Palette.KEEPER_SHORTS, 0.88, 0.24, 0.0, _KIT_GROW, atlas)
			return _cloth(Palette.SHOOTER_SHORTS, 0.88, 0.24, 0.0, _KIT_GROW, atlas)
		SURFACE_SOCKS:
			# Socks carry the kit colour, not the shorts colour: the legs are
			# half the silhouette and a dark leg on dark turf disappears.
			if keeper:
				return _cloth(Palette.shade(Palette.KEEPER_JERSEY, 0.86), 0.92, 0.2, 0.35)
			return _cloth(Palette.shade(Palette.SHOOTER_JERSEY, 0.9), 0.92, 0.2, 0.35)
		SURFACE_BOOTS:
			return _boot_material()
	# An unnamed surface keeps whatever the import gave it rather than turning
	# into a default white slab.
	return _cloth(Palette.SKIN, 0.7, 0.3, 0.0)


## Woven kit cloth. `rim` lifts the outline of the body away from the stand
## behind it, which is most of what makes a figure read at 11 m.
static func _cloth(colour: Color, roughness: float, specular: float, rim: float,
		grow_amount: float = _KIT_GROW, texture: Texture2D = null) -> StandardMaterial3D:
	var mat := _base()
	if texture != null:
		mat.albedo_texture = texture
		mat.albedo_color = Color.WHITE
		var inner := 1.0 - _KIT_UV_MARGIN * 2.0
		var uv_span := _KIT_UV_MAX - _KIT_UV_MIN
		var uv_scale := Vector2(inner / uv_span.x, inner / uv_span.y)
		var uv_offset := Vector2(_KIT_UV_MARGIN, _KIT_UV_MARGIN) - _KIT_UV_MIN * uv_scale
		mat.uv1_scale = Vector3(uv_scale.x, uv_scale.y, 1.0)
		mat.uv1_offset = Vector3(uv_offset.x, uv_offset.y, 0.0)
	else:
		mat.albedo_color = Palette.clamp_albedo(colour)
	mat.roughness = roughness
	mat.metallic_specular = specular
	# See _KIT_GROW: this is what keeps the body inside the shirt.
	if not is_zero_approx(grow_amount):
		mat.grow = true
		mat.grow_amount = grow_amount
	if rim > 0.0:
		mat.rim_enabled = true
		mat.rim = rim
		mat.rim_tint = 0.5
	return mat


static func _skin_material(texture: Texture2D = null) -> StandardMaterial3D:
	var mat := _base()
	if texture != null:
		mat.albedo_texture = texture
		mat.albedo_color = Color.WHITE
	else:
		mat.albedo_color = Palette.clamp_albedo(Palette.SKIN)
	mat.roughness = 0.54
	mat.metallic_specular = 0.42
	mat.grow = true
	mat.grow_amount = _SKIN_SHRINK
	# Two humanoids on screen, so a little scattering is affordable, and without
	# it a dense face reads as painted plastic under a hard key light.
	mat.subsurf_scatter_enabled = true
	mat.subsurf_scatter_strength = 0.20
	return mat


static func _boot_material() -> StandardMaterial3D:
	var mat := _base()
	mat.albedo_color = Palette.clamp_albedo(Palette.BOOT)
	mat.roughness = 0.24
	mat.metallic_specular = 0.65
	mat.clearcoat_enabled = true
	mat.clearcoat = 0.5
	mat.clearcoat_roughness = 0.12
	# The boot is a shell over the foot, same as the shirt is over the chest.
	mat.grow = true
	mat.grow_amount = _KIT_GROW
	return mat


## A surface that is switched off. See `_HIDDEN_ALPHA`.
##
## BLENDED and not scissored, and the difference is a shadow. A scissored surface
## is opaque as far as the renderer is concerned, so it still goes into the shadow
## map: the hands this switches off went on casting five finger shadows onto the
## glove drawn over them, which at close range is a handful of black claws lying
## across an orange mitt. Godot skips alpha BLENDED geometry in the shadow pass, so
## a surface hidden this way is gone from the picture and from the light.
static func _hidden() -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(0.0, 0.0, 0.0, _HIDDEN_ALPHA)
	return mat


static func _base() -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
	mat.diffuse_mode = BaseMaterial3D.DIFFUSE_BURLEY
	mat.specular_mode = BaseMaterial3D.SPECULAR_SCHLICK_GGX
	mat.metallic = 0.0
	# The kit shells are open sheets pushed 6 mm off the body, so they are only
	# ever seen from one side in practice, but a dive shows the far one edge on.
	mat.cull_mode = BaseMaterial3D.CULL_BACK
	# A figure that RECEIVES its own shadow is a figure covered in acne.
	#
	# This was measured, not guessed: rendering the same frame with the mesh's
	# shadow casting switched off cleaned the shirt completely, which places the
	# fault squarely on self shadowing. The kit is a millimetre thin sheet, so its
	# own shadow map depth sits on top of the surface it is meant to shade, and
	# every square centimetre facing away from the sun breaks up into a stipple of
	# lit and unlit pixels. The sun's depth bias belongs to `SkyController` and is
	# tuned for the stadium, not for a shirt.
	#
	# Switching RECEPTION off rather than casting keeps what actually matters,
	# which is the figure's own shadow lying on the turf underneath him. What is
	# given up is an arm shading a chest, on two bodies seen from 11 m.
	mat.disable_receive_shadows = true
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return mat


# --- small tree helpers -------------------------------------------------------


static func _find_skeleton(node: Node) -> Skeleton3D:
	if node is Skeleton3D:
		return node as Skeleton3D
	for child in node.get_children():
		var hit := _find_skeleton(child)
		if hit != null:
			return hit
	return null


static func _find_mesh(node: Node) -> MeshInstance3D:
	if node is MeshInstance3D:
		return node as MeshInstance3D
	for child in node.get_children():
		var hit := _find_mesh(child)
		if hit != null:
			return hit
	return null


static func _vec_of(source: Dictionary, key: String, fallback: Vector3) -> Vector3:
	var value: Variant = source.get(key, null)
	if typeof(value) == TYPE_VECTOR3:
		var out: Vector3 = value
		return out
	return fallback


static func _basis_of(source: Dictionary, key: String, fallback: Basis) -> Basis:
	var value: Variant = source.get(key, null)
	if typeof(value) != TYPE_BASIS:
		return fallback
	var out: Basis = value
	if out.determinant() < 0.000001:
		return fallback
	return out.orthonormalized()


