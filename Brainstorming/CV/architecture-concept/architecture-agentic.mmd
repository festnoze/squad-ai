%% Architecture conceptuelle. Services distants regroupés dans le périmètre infrastructure.
  subgraph section_app["Tier 2 — Application et agents"]
    direction LR
    subgraph group_agent_graph["Workflow agentique"]
      agent_run["Service de workflow"]
      graph_state["État partagé / messages"]
      supervisor["Agent superviseur"]
      route_decision{"Quel agent appeler ?"}
      research_agent["Agent recherche"]
      analyst_agent["Agent analyse"]
      writer_agent["Agent synthèse"]
      review_agent["Agent relecteur"]
      quality_gate{"Révision nécessaire ?"}
      run_output["Résultat structuré"]
      run_failed["Arrêt contrôlé"]
      run_budget["Budget / nombre d’itérations"]
    end
    subgraph group_agent_capabilities["Anatomie d’un agent"]
      agent_profile["Rôle / objectifs / contexte"]
      skills["Catalogue de skills"]
      skill_loader["Chargement des instructions"]
      tool_decision{"Outil nécessaire ?"}
      tool_catalog["Tools disponibles"]
      tool_dispatch["Exécuteur de tools"]
      agent_messages["Messages / handoffs"]
      agent_response["Réponse modèle structurée"]
    end
    subgraph group_ai_ports["Ports IA / mémoire"]
      llm_port["Port génération LLM"]
      prompt_port["Port de prompts"]
      tool_port["Port d’exécution tools"]
      memory_port["Port mémoire / retrieval"]
      checkpoint_port["Port checkpoint"]
      trace_port["Port de traçage"]
      graph_port["Port d’orchestration"]
    end
  end
  subgraph section_infra["Tier 4 — Infrastructure : adaptateurs et services externes"]
    direction LR
    subgraph group_ai_adapters["Adaptateurs IA / tools"]
      llm_adapter["Adaptateur LLM"]
      prompt_adapter["Adaptateur prompts"]
      tool_adapter["Adaptateurs de tools"]
      memory_adapter["Adaptateur retrieval"]
      checkpoint_adapter["Checkpointer"]
      langgraph_runtime["Exécuteur LangGraph"]
      trace_adapter["Adaptateur traces Langfuse"]
      llm_client["Client fournisseur LLM"]
      prompt_render["Compilation du prompt"]
    end
    subgraph group_cache_layer["Couche de cache"]
      cache_key["Clé contexte / prompt / modèle"]
      cache_lookup["Lecture cache de réponse"]
      cache_decision{"Cache hit ou miss ?"}
      cache_write["Écriture / TTL"]
      cached_output["Réponse LLM en cache"]
      prompt_local_cache["Cache local des prompts"]
      cache_invalidate["Invalidation / versions"]
    end
    subgraph group_llm_services["Services de modèles · service externe"]
      llm_provider["Service LLM distant"]
      embedding_provider["Service embeddings"]
      judge_provider["Service LLM évaluateur"]
    end
    subgraph group_memory_services["Mémoire et cache distants · service externe"]
      response_cache["Cache de réponses LLM"]
      checkpoint_db["Stockage des checkpoints"]
      vector_db["Base vectorielle"]
    end
    subgraph group_lf_prompts["Langfuse · prompts · service externe"]
      lf_prompts["Registre de prompts"]
      prompt_version["Version / label du prompt"]
      prompt_variables["Variables et schéma"]
    end
    subgraph group_lf_traces["Langfuse · traces · service externe"]
      lf_traces["Traces / sessions / spans"]
      lf_generation["Générations / tokens / coût"]
      lf_scores["Scores / annotations"]
    end
    subgraph group_lf_evals["Langfuse · évaluations · service externe"]
      lf_datasets["Datasets / références"]
      lf_experiments["Expériences / régressions"]
      lf_eval["Évaluateur LLM-as-judge"]
      lf_code_eval["Évaluations déterministes"]
      lf_feedback["Feedback humain"]
    end
    subgraph group_evaluation_jobs["Adaptateurs d’évaluation"]
      eval_job["Job d’évaluation asynchrone"]
      eval_adapter["Adaptateur LLM évaluateur"]
    end
  end
