
# Agent skills installed via `npx skills add` (reinstallable, not versioned)
.agents/
.claude/skills/

# Build output
dist/

# Unity projects (games/*): caches, builds and generated files
games/*/[Ll]ibrary/
games/*/[Tt]emp/
games/*/[Oo]bj/
games/*/[Bb]uild/
games/*/[Bb]uilds/
games/*/[Ll]ogs/
games/*/[Uu]ser[Ss]ettings/
games/*/TestResults/
games/*/ThirdParty_staging/
games/*/*.csproj
games/*/*.sln
games/*/.unity.lock/
games/*/.unity.queue/
games/*/*.unity.queue
games/*/scratchpad/
games/*/smoke/
games/*/.utmp/
# Unity .meta files hold each asset's GUID and import settings: without them a fresh clone gets new GUIDs
# and every material, scene or prefab reference breaks. The root .gitignore ignores "*.meta" (Visual Studio
# template) and "*.wav", so re-include both for the Unity projects.
!games/*/**/*.meta
!games/*/Assets/**/*.wav
# Unity Test Framework / Performance Testing leftovers (and their .meta), regenerated on every test run
games/*/Assets/InitTestScene*.unity*
games/*/Assets/Resources/PerformanceTestRun*.json*
# Generated benchmark projects with their own git repository
